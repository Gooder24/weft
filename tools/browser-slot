#!/usr/bin/env bash
# Usage: tools/browser-slot <command> [args...]   (wraps any test run that starts a headless browser)
# One browser run at a time per machine, capped in memory. Dell and e540 have 3.7 GB; two agent threads each
# starting Chromium pushed dell into swap until it froze (2026-11-07). A run over the cap is killed; the machine
# and the other threads keep working. The lock is per user and machine, so other projects can share it.
# BROWSER_SLOT_WAIT: seconds to wait for the slot (default 900). BROWSER_SLOT_MEM: memory cap (default 1500M).
set -u
[ -n "${BROWSER_SLOT:-}" ] && exec "$@"   # already inside a slot (run.sh calling node): don't wait on ourselves
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
exec 9>"$XDG_RUNTIME_DIR/browser-slot.lock"
if ! flock -n 9; then
  echo "browser-slot: na tomto stroji beží iný test s prehliadačom, čakám (najviac ${BROWSER_SLOT_WAIT:-900} s)" >&2
  flock -w "${BROWSER_SLOT_WAIT:-900}" 9 || { echo "browser-slot: slot sa neuvoľnil, skús to neskôr" >&2; exit 75; }
fi
export BROWSER_SLOT=1
# The lock (fd 9) is inherited by the command and its children and released when the last of them exits.
exec systemd-run --user --scope --quiet --collect \
  -p MemoryMax="${BROWSER_SLOT_MEM:-1500M}" -p MemorySwapMax=256M -- "$@"
