#!/usr/bin/env bash
# Publish a complete immutable client before switching the entry page. Keeps old releases for open windows.
set -euo pipefail
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
python3 tools/release-app.py "$work/app" > "$work/id"
release=$(cat "$work/id")
ssh asus "mkdir -p ~/matrix-spike/app/releases ~/matrix-spike/backups/app-$release; cp ~/matrix-spike/app/index.html ~/matrix-spike/app/sw.js ~/matrix-spike/backups/app-$release/"
tar -C "$work/app/releases" -c "$release" | ssh asus 'tar -x -C ~/matrix-spike/app/releases'
# Stable assets remain for old clients and their existing update checks.
tar -C app -c --exclude=index.html --exclude=sw.js . | ssh asus 'tar -x -C ~/matrix-spike/app'
scp -q "$work/app/release.json" "$work/app/sw.js" asus:matrix-spike/app/
scp -q "$work/app/index.html" asus:matrix-spike/app/index.html.next
ssh asus 'mv ~/matrix-spike/app/index.html.next ~/matrix-spike/app/index.html'
printf 'Published release %s\n' "$release"
