#!/usr/bin/env python3
"""Weft's language check: every Slovak text in app/*.js is wrapped in T(...) or T`...` and has its English in
app/i18n-en.js (see app/i18n.js). Prints what is missing and exits 1; `--stale` also lists English nobody uses.
A string that must stay Slovak (data sent to people, a key the bridge compares) gets `// i18n-ignore` on its line."""
import json, re, sys
from pathlib import Path

APP = Path(__file__).resolve().parent.parent / 'app'
FILES = [p for p in sorted(APP.glob('*.js')) if p.name not in ('i18n.js', 'i18n-en.js', 'qrcode.js', 'sw.js')]
SK = re.compile(r'[áäčďéíĺľňóôŕšťúýžÁÄČĎÉÍĹĽŇÓÔŔŠŤÚÝŽ]')
# Slovak's short words that a sentence without diacritics still has („8 z 10“, „denne po“).
SMALL = re.compile(r'(?:^|\s)(z|zo|v|vo|do|od|pre|po|je|sa|nie|alebo|cez|za|pri|ku|so|aj|ani|ako|už|len|dnes|teraz)\s', re.I)
REGEX_BEFORE = set('(,=:[!&|?{};+-*%<>~^') | {'return', 'typeof', 'case', 'in', 'of', 'delete', 'void', 'new', 'throw', ''}


def strings(src):
    """(start, end, kind, cooked parts) for every string and template literal, with the token before it."""
    i, n, out, prev = 0, len(src), [], ''
    def template(i):  # i at the opening backtick; returns (end, parts, nested strings)
        parts, cur, j, inner = [], '', i + 1, []
        while j < n:
            c = src[j]
            if c == '\\': cur += src[j:j + 2]; j += 2; continue
            if c == '`': parts.append(cur); return j + 1, parts, inner
            if c == '$' and src[j + 1:j + 2] == '{':
                parts.append(cur); cur = ''
                j, sub = expression(j + 2); inner += sub; continue
            cur += c; j += 1
        raise SyntaxError('unclosed template')
    def expression(j):  # inside ${ ... }, returns index after the closing brace
        depth, sub, p = 1, [], ''
        while j < n:
            c = src[j]
            if c in '\'"`':
                e, kind, parts, inner = literal(j); sub.append((j, e, kind, parts, p)); sub += inner; j = e; p = 'str'; continue
            if c == '{': depth += 1
            elif c == '}':
                depth -= 1
                if depth == 0: return j + 1, sub
            if not c.isspace(): p = c
            j += 1
        raise SyntaxError('unclosed ${')
    def literal(j):
        q = src[j]
        if q == '`':
            e, parts, inner = template(j); return e, 'tpl', parts, inner
        k = j + 1
        while src[k] != q:
            k += 2 if src[k] == '\\' else 1
        return k + 1, 'str', [src[j + 1:k]], []
    while i < n:
        c = src[i]
        if src.startswith('//', i): i = src.find('\n', i); i = n if i < 0 else i; continue
        if src.startswith('/*', i): i = src.index('*/', i) + 2; continue
        if c in '\'"`':
            e, kind, parts, inner = literal(i); out.append((i, e, kind, parts, prev)); out += inner; i = e; prev = 'str'; continue
        if c == '/' and prev in REGEX_BEFORE:
            k, cls = i + 1, False
            while k < n and (cls or src[k] != '/'):
                if src[k] == '\\': k += 1
                elif src[k] == '[': cls = True
                elif src[k] == ']': cls = False
                k += 1
            i = k + 1
            while i < n and src[i].isalpha(): i += 1
            prev = 're'; continue
        if c.isalnum() or c in '_$':
            m = re.match(r'[\w$]+', src[i:]); prev = m.group(); i += len(prev); continue
        if not c.isspace(): prev = c
        i += 1
    return out


ESC = {'n': '\n', 't': '\t', 'r': '\r', 'b': '\b', 'f': '\f', 'v': '\v', '0': '\0'}


def unescape(s):
    def one(m):
        e = m.group(1)
        if e[0] == 'u': return chr(int(e[2:-1] if e[1] == '{' else e[1:], 16))
        if e[0] == 'x': return chr(int(e[1:], 16))
        return ESC.get(e, e)
    return re.sub(r'\\(u\{[0-9a-fA-F]+\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)', one, s, flags=re.S)


def main():
    en = {}
    for line in (APP / 'i18n-en.js').read_text().splitlines():
        m = re.match(r'\s*("(?:[^"\\]|\\.)*"): ("(?:[^"\\]|\\.)*"),$', line)
        if m: en[json.loads(m.group(1))] = json.loads(m.group(2))
    vocab = {w for k in en for w in re.findall(r'\w{3,}', k.lower())} - {w for v in en.values() for w in re.findall(r'\w{3,}', v.lower())}
    bad, used = [], set()
    for path in FILES:
        src = path.read_text()
        lines = src.splitlines()
        for start, end, kind, parts, prev in strings(src):
            line = src.count('\n', 0, start) + 1
            if 'i18n-ignore' in lines[line - 1]: continue
            text = '{}'.join(unescape(p) for p in parts)
            wrapped = (prev == 'T' and kind == 'tpl') or (src[max(0, start - 2):start] == 'T(')
            after = src[end:end + 40].lstrip()
            if after.startswith(':') and prev in ('{', ','): continue  # an object key
            if prev == 'import' or src[max(0, start - 5):start].strip().endswith('from'): continue
            if wrapped:
                used.add(text)
                if text not in en: bad.append(f'{path.name}:{line}: no English for {json.dumps(text, ensure_ascii=False)}')
                elif text.count('{}') != len(re.findall(r'\{\d*\}', en[text])): bad.append(f'{path.name}:{line}: English has other placeholders than {json.dumps(text, ensure_ascii=False)}')
                continue
            words = re.findall(r'\w{3,}', text.lower())
            if re.fullmatch(r'[a-z0-9 ]+', text) and text.count(' ') >= 2: continue  # search keywords (Ctrl+K), both languages
            bare = re.sub(r'\{\}', ' ', text)
            if SK.search(bare) or (words and any(w in vocab for w in words) and ' ' in text.strip()) or SMALL.search(bare) or (text.rstrip('.:…') in en and text not in en):
                bad.append(f'{path.name}:{line}: not wrapped in T: {json.dumps(text, ensure_ascii=False)[:90]}')
    print('\n'.join(bad))
    if '--stale' in sys.argv:
        for k in sorted(set(en) - used): print(f'i18n-en.js: unused {json.dumps(k, ensure_ascii=False)}')
    print(f'{len(bad)} problems, {len(used)} texts wrapped, {len(en)} English entries', file=sys.stderr)
    sys.exit(1 if bad else 0)


main()
