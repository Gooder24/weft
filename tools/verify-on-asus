#!/usr/bin/env bash
# Usage: tools/verify-on-asus <brief.md> [verdict, default overenie/verdikt.md]
# Runs the independent verifier (skill overenie) on asus instead of here. On dell and e540 (3.7 GB) a verifier with
# its browser took an hour and starved every other thread (2026-11-07); asus has 15 GB and 12 cores.
# The working tree goes over as it is, uncommitted changes and .git included, into asus ~/weft-verify/<run>/.
# Only the joined verdict and each verifier's output.txt come back; screenshots of Karchi's chats stay on asus, pruned after a day.
# Blocks until the verdict is written: in a T3 thread run it in the background and wait on the task.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
brief=$1 verdict=${2:-overenie/verdikt.md}
[ -f "$brief" ] || { echo "verify-on-asus: brief $brief neexistuje" >&2; exit 2; }
# Skill overenie: the builder runs run.sh first; a red run goes to the verifier only with its failures named in the brief.
grep -q 'run.sh' "$brief" || echo "verify-on-asus: brief nespomína výstup run.sh (skill overenie, brána pred overovateľom)" >&2
run=$(uname -n | cut -d- -f1)-$(date +%Y%m%d-%H%M%S)-$$
rm -f "$verdict"
ssh asus 'mkdir -p ~/weft-verify && find ~/weft-verify -mindepth 1 -maxdepth 1 -mtime +0 -exec rm -rf {} +'
# Other threads write to .git meanwhile: tar's 1 ("file changed as we read it") still copied everything else.
{ tar -c --warning=no-file-changed --warning=no-file-removed --exclude=node_modules --exclude='overenie/20*' . || [ $? -eq 1 ]; } |
  ssh asus "mkdir ~/weft-verify/$run && tar -x -C ~/weft-verify/$run"
ssh asus "cat > ~/weft-verify/$run/.verifier-brief.md" < "$brief"
echo "verify-on-asus: overovateľ beží na asuse v ~/weft-verify/$run (jednotka weft-verify-$run)" >&2
# A user unit, not a child of this ssh: a dropped connection does not kill the verifier. Capped so it cannot hurt
# the live Weft server on asus. verify.sh (skill overenie) runs two verifiers side by side, Fable and the first of its
# chain; OVERENIE_KTO replaces the chain.
kto=; [ -n "${OVERENIE_KTO:-}" ] && kto="-E 'OVERENIE_KTO=$OVERENIE_KTO'"
ssh asus "cd ~/weft-verify/$run && systemd-run --user --quiet --wait --collect --same-dir --unit=weft-verify-$run \
  -p MemoryMax=6G -E PATH=\$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin $kto \
  \$HOME/.work/karchi-skills/overenie/verify.sh .verifier-brief.md '$verdict'" || true
ssh asus "cd ~/weft-verify/$run && tar -c --ignore-failed-read '$verdict' overenie/*/output.txt 2>/dev/null" | tar -x
if [ -s "$verdict" ]; then echo "verify-on-asus: verdikt v $verdict" >&2
else echo "verify-on-asus: verdikt nevznikol, pozri overenie/*/output.txt" >&2; exit 1; fi
