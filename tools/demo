class World:
    """Rooms, account data and every change in order: a sync after `since` gets the changes after it."""

    def __init__(self):
        self.lock = threading.Condition()
        self.seq = 0
        self.changes = []  # (seq, room id or None, kind, payload)
        self.rooms = {}
        self.account = {}
        self.media = {}
        self.calendar = {'version': 1, 'doc': calendar_doc()}
        self.n = 0
        start = NOW - 2 * MIN
        today = time.strftime('%Y-%m-%d')
        self.account['sk.karchi.window'] = {'day': today, 'start': start, 'end': start + 8 * HOUR, 'used': 1, 'count': 3, 'minutes': 480}
        self.account['sk.karchi.batches'] = {'mode': 'manual', 'times': [], 'edupage': False}
        self.build()

    def eid(self):
        self.n += 1
        return f'$demo{self.n}'

    def event(self, room, sender, ts, type_, content, state_key=None):
        e = {'event_id': self.eid(), 'room_id': room, 'sender': sender, 'origin_server_ts': ts, 'type': type_, 'content': content, 'unsigned': {}}
        if state_key is not None: e['state_key'] = state_key
        return e

    def room(self, rid, creator, members, name=None, bridge=None, created=NOW - 30 * DAY):
        r = {'id': rid, 'state': [], 'timeline': [], 'members': {}, 'receipts': {}}
        r['state'].append(self.event(rid, creator, created, 'm.room.create', {'creator': creator, 'room_version': '10'}, ''))
        for uid, display in [(ME, 'Ty')] + members:
            r['state'].append(self.event(rid, uid, created, 'm.room.member', {'membership': 'join', 'displayname': display}, uid))
            r['members'][uid] = display
        if name: r['state'].append(self.event(rid, creator, created, 'm.room.name', {'name': name}, ''))
        if bridge: r['state'].append(self.event(rid, creator, created, 'm.bridge', bridge, bridge['channel']['id']))
        self.rooms[rid] = r
        return r

    def build(self):
        edu = self.room(f'!edupage:{HS}', f'@edupagebot:{HS}', [(PEOPLE[k][0], PEOPLE[k][1]) for k in ('teacher', 'teacher2')])
        for ago, who, text in EDUPAGE:
            edu['timeline'].append(self.event(edu['id'], PEOPLE[who][0], NOW - ago * MIN, 'm.room.message', {'msgtype': 'm.text', 'body': text}))
        for c in CHATS:
            rid = f'!{c["id"]}:{HS}'
            members = [PEOPLE[k] for k in c['people']]
            bridge = None
            if c['net'] in BRIDGES:
                proto, display = BRIDGES[c['net']]
                channel = {'id': c.get('name') or members[0][0], 'displayname': c.get('name') or members[0][1]}
                bridge = {'bridgebot': f'@{c["net"]}bot:{HS}', 'protocol': {'id': proto, 'displayname': display}, 'channel': channel}
                if 'server' in c: bridge['network'] = {'id': c['server'][0], 'displayname': c['server'][1]}
            r = self.room(rid, ME, members, c.get('name'), bridge)
            for ago, who, text in c['messages']:
                sender = PEOPLE[who][0] if who else ME
                r['timeline'].append(self.event(rid, sender, NOW - ago * MIN, 'm.room.message', {'msgtype': 'm.text', 'body': text}))
            # What you wrote last, and everything before it, counts as read; what came after waits for you.
            mine = [e for e in r['timeline'] if e['sender'] == ME]
            if mine: r['receipts'][ME] = mine[-1]['event_id']

    def change(self, room, kind, payload):
        with self.lock:
            self.seq += 1
            self.changes.append((self.seq, room, kind, payload))
            self.lock.notify_all()

    def send(self, rid, type_, content, txn):
        r = self.rooms[rid]
        e = self.event(rid, ME, int(time.time() * 1000), type_, content)
        e['unsigned'] = {'transaction_id': txn}
        r['timeline'].append(e)
        r['receipts'][ME] = e['event_id']
        self.change(rid, 'timeline', e)
        others = [u for u in r['members'] if u != ME]
        if type_ == 'm.room.message' and others and not rid.startswith('!edupage'):
            threading.Thread(target=self.answer, args=(rid, others[0]), daemon=True).start()
        return e['event_id']

    def answer(self, rid, who):
        """The other side types for a moment and answers with a canned line."""
        time.sleep(1.2)
        self.change(rid, 'typing', [who])
        time.sleep(2.0)
        self.change(rid, 'typing', [])
        r = self.rooms[rid]
        e = self.event(rid, who, int(time.time() * 1000), 'm.room.message', {'msgtype': 'm.text', 'body': REPLIES[self.n % len(REPLIES)]})
        r['timeline'].append(e)
        self.change(rid, 'timeline', e)

    def unread(self, r):
        read = r['receipts'].get(ME)
        ids = [e['event_id'] for e in r['timeline']]
        after = r['timeline'][ids.index(read) + 1:] if read in ids else r['timeline']
        return sum(1 for e in after if e['sender'] != ME)

    def joined(self, r, events, typing=None):
        out = {'state': {'events': r['state']}, 'timeline': {'events': events, 'limited': False, 'prev_batch': f'p_{r["id"]}'},
               'ephemeral': {'events': []}, 'account_data': {'events': []}, 'unread_notifications': {'notification_count': self.unread(r), 'highlight_count': 0}}
        if r['receipts']:
            out['ephemeral']['events'].append({'type': 'm.receipt', 'content': {eid: {'m.read': {u: {'ts': NOW}}} for u, eid in r['receipts'].items()}})
        if typing is not None: out['ephemeral']['events'].append({'type': 'm.typing', 'content': {'user_ids': typing}})
        return out

    def sync(self, since, timeout):
        with self.lock:
            if since is None:
                return {'next_batch': str(self.seq), 'account_data': {'events': [{'type': k, 'content': v} for k, v in self.account.items()]},
                        'rooms': {'join': {rid: self.joined(r, r['timeline']) for rid, r in self.rooms.items()}}}
            after = int(since)
            end = time.time() + timeout / 1000
            while self.seq <= after and time.time() < end:
                self.lock.wait(end - time.time())
            news = [c for c in self.changes if c[0] > after]
            out = {'next_batch': str(self.seq), 'account_data': {'events': []}, 'rooms': {'join': {}}}
            for _, rid, kind, payload in news:
                if kind == 'account':
                    out['account_data']['events'].append(payload)
                    continue
                r = self.rooms[rid]
                j = out['rooms']['join'].setdefault(rid, {'timeline': {'events': [], 'limited': False}, 'ephemeral': {'events': []},
                                                          'unread_notifications': {'notification_count': self.unread(r), 'highlight_count': 0}})
                if kind == 'timeline': j['timeline']['events'].append(payload)
                elif kind == 'typing': j['ephemeral']['events'].append({'type': 'm.typing', 'content': {'user_ids': payload}})
                elif kind == 'receipt': j['ephemeral']['events'].append({'type': 'm.receipt', 'content': {payload: {'m.read': {ME: {'ts': int(time.time() * 1000)}}}}})
            return out

    def search(self, term):
        term = term.lower()
        hits = [e for r in self.rooms.values() for e in r['timeline'] if term in str(e['content'].get('body', '')).lower()]
        hits.sort(key=lambda e: -e['origin_server_ts'])
        return {'search_categories': {'room_events': {'count': len(hits), 'results': [{'rank': 1, 'result': e} for e in hits[:50]]}}}


