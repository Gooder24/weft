def day_at(days, hour, minute=0):
    """An ISO time `days` from today at hour:minute, local time."""
    t = time.localtime()
    base = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, hour, minute, 0, 0, 0, -1))
    return time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(base + days * 86400)).replace('+0000', 'Z')


