class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        if os.environ.get('DEMO_LOG'): super().log_message(fmt, *args)

    def reply(self, code, body=None, ctype='application/json', headers=None):
        data = body if isinstance(body, bytes) else json.dumps({} if body is None else body).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        for k, v in (headers or {}).items(): self.send_header(k, v)
        self.end_headers()
        if self.command == 'HEAD': return
        try: self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError): self.close_connection = True  # the page stopped waiting (a long poll)

    def body(self):
        raw = self.raw
        if 'json' in (self.headers.get('Content-Type') or ''):
            try: return json.loads(raw or b'{}')
            except ValueError: return {}
        return raw

    def do_GET(self): self.route()
    def do_HEAD(self): self.route()
    def do_POST(self): self.route()
    def do_PUT(self): self.route()
    def do_DELETE(self): self.route()
    def do_OPTIONS(self): self.reply(204, b'', 'text/plain')

    def route(self):
        # Read every body first: one left unread would spoil the next request on the same connection.
        n = int(self.headers.get('Content-Length') or 0)
        self.raw = self.rfile.read(n) if n else b''
        u = urllib.parse.urlsplit(self.path)
        path, query = urllib.parse.unquote(u.path), dict(urllib.parse.parse_qsl(u.query))
        if path == '/demo': return self.start_page()
        if not path.startswith('/_'): return self.static(u.path)
        if path.startswith('/_matrix/client/'): return self.matrix(path, query)
        if path.startswith('/_matrix/media/') or path.startswith('/_matrix/client/v1/media/'): return self.media(path)
        if path.startswith('/_bridges/'): return self.bridge(path)
        if path.startswith('/_archive/'): return self.archive(path, query)
        if path.startswith('/_calendar/'): return self.calendar(path, query)
        if path.startswith('/_feed/'): return self.feed(path, query)
        return self.reply(404, {'errcode': 'M_UNRECOGNIZED', 'error': 'not in the demo'})

    def start_page(self):
        """Signs the browser in as the demo user and opens Weft."""
        page = f'''<!doctype html><meta charset="utf-8"><title>Weft demo</title><script>
localStorage.setItem('ep_token', {json.dumps(TOKEN)}); localStorage.setItem('ep_user', {json.dumps(ME)});
if (localStorage.getItem('ep_show_all') === null) localStorage.setItem('ep_show_all', '1'); // the inbox lists every chat, not only unread ones
location.replace('/');
</script>'''
        self.reply(200, page.encode(), 'text/html; charset=utf-8')

    def static(self, raw):
        rel = urllib.parse.unquote(raw).lstrip('/') or 'index.html'
        full = os.path.realpath(os.path.join(APP, rel))
        if not full.startswith(os.path.realpath(APP) + os.sep) or not os.path.isfile(full):
            return self.reply(404, b'not found', 'text/plain')
        ctype = mimetypes.guess_type(full)[0] or 'application/octet-stream'
        if ctype.startswith('text/') or ctype in ('application/javascript', 'application/json', 'image/svg+xml'): ctype += '; charset=utf-8'
        with open(full, 'rb') as f: self.reply(200, f.read(), ctype)

    def authed(self):
        return self.headers.get('Authorization') == f'Bearer {TOKEN}'

    def matrix(self, path, query):
        p = re.sub(r'^/_matrix/client/(v3|r0|v1)', '', path)
        m = self.command
        if path == '/_matrix/client/versions': return self.reply(200, {'versions': ['v1.11', 'v1.12']})
        if p == '/login':
            if m == 'GET': return self.reply(200, {'flows': [{'type': 'm.login.password'}]})
            return self.reply(200, {'access_token': TOKEN, 'user_id': ME, 'device_id': 'DEMO'})
        if not self.authed(): return self.reply(401, {'errcode': 'M_UNKNOWN_TOKEN', 'error': 'Sign in through /demo'})
        if p == '/logout' or p == '/logout/all': return self.reply(200, {})
        if p == '/account/whoami': return self.reply(200, {'user_id': ME, 'device_id': 'DEMO'})
        if p == '/sync': return self.reply(200, WORLD.sync(query.get('since'), int(query.get('timeout') or 0)))
        if p == '/pushrules/' or p == '/pushrules': return self.reply(200, {'global': {}})
        if p == '/capabilities': return self.reply(200, {'capabilities': {}})
        if p == '/search': return self.reply(200, WORLD.search(((self.body() or {}).get('search_categories') or {}).get('room_events', {}).get('search_term', '')))
        if p.startswith('/profile/'): return self.reply(200, {'displayname': WORLD.rooms and next((r['members'][u] for r in WORLD.rooms.values() for u in r['members'] if u == p.split('/')[2]), None)})
        acc = re.match(r'^/user/([^/]+)/account_data/(.+)$', p)
        if acc:
            kind = acc.group(2)
            if m == 'PUT':
                WORLD.account[kind] = self.body()
                WORLD.change(None, 'account', {'type': kind, 'content': WORLD.account[kind]})
                return self.reply(200, {})
            return self.reply(200, WORLD.account[kind]) if kind in WORLD.account else self.reply(404, {'errcode': 'M_NOT_FOUND'})
        room = re.match(r'^/rooms/([^/]+)/(.+)$', p)
        if room:
            rid, rest = room.groups()
            r = WORLD.rooms.get(rid)
            if not r: return self.reply(404, {'errcode': 'M_NOT_FOUND', 'error': 'no such room in the demo'})
            if rest == 'messages': return self.reply(200, {'chunk': [], 'start': query.get('from', ''), 'state': []})
            if rest == 'joined_members': return self.reply(200, {'joined': {u: {'display_name': n} for u, n in r['members'].items()}})
            if rest == 'members': return self.reply(200, {'chunk': [e for e in r['state'] if e['type'] == 'm.room.member']})
            if rest.startswith('state'): return self.reply(200, r['state'] if rest == 'state' else {})
            send = re.match(r'^send/([^/]+)/(.+)$', rest)
            if send and m == 'PUT': return self.reply(200, {'event_id': WORLD.send(rid, send.group(1), self.body(), send.group(2))})
            if rest.startswith('receipt/') or rest == 'read_markers':
                b = self.body() if rest == 'read_markers' else {}
                eid = b.get('m.read') or b.get('m.fully_read') or rest.split('/')[-1]
                r['receipts'][ME] = eid
                WORLD.change(rid, 'receipt', eid)
                return self.reply(200, {})
            if rest.startswith('context/'):
                eid = rest.split('/', 1)[1]
                ev = next((e for e in r['timeline'] if e['event_id'] == eid), None)
                return self.reply(200, {'event': ev, 'events_before': [], 'events_after': [], 'state': []}) if ev else self.reply(404, {'errcode': 'M_NOT_FOUND'})
            if rest.startswith('event/'):
                ev = next((e for e in r['timeline'] if e['event_id'] == rest.split('/', 1)[1]), None)
                return self.reply(200, ev) if ev else self.reply(404, {'errcode': 'M_NOT_FOUND'})
            if rest.startswith('typing/') or rest.startswith('redact/') or rest == 'leave' or rest == 'forget': return self.reply(200, {})
            return self.reply(200, {})
        return self.reply(404, {'errcode': 'M_UNRECOGNIZED', 'error': 'not in the demo'})

    def media(self, path):
        if path.endswith('/upload') and self.command == 'POST':
            data = self.body()
            mid = f'demo{len(WORLD.media) + 1}'
            WORLD.media[mid] = (data if isinstance(data, bytes) else json.dumps(data).encode(), self.headers.get('Content-Type') or 'application/octet-stream')
            return self.reply(200, {'content_uri': f'mxc://{HS}/{mid}'})
        mid = path.rstrip('/').split('/')[-1]
        if mid in WORLD.media: return self.reply(200, WORLD.media[mid][0], WORLD.media[mid][1])
        return self.reply(404, {'errcode': 'M_NOT_FOUND'})

    def bridge(self, path):
        net = path.split('/')[2]
        if net == 'discord' and path.endswith('/ping'):
            return self.reply(200, {'Discord': {'logged_in': True, 'connected': True, 'id': '900000000000000000'}})
        if path.endswith('/whoami'): return self.reply(200, {'logins': LOGINS.get(net, [])})
        if net == 'gmail' and '/codes' in path:
            time.sleep(5)  # a long poll that never brings a code
            return self.reply(200, {'seq': 0, 'codes': [], 'ttl': 600, 'now': int(time.time() * 1000)})
        if self.command == 'GET': return self.reply(200, {})
        return self.reply(403, {'errcode': 'M_FORBIDDEN', 'error': 'Accounts cannot be changed in the demo.'})

    def archive(self, path, query):
        if path == '/_archive/chats': return self.reply(200, {'chats': archive_chats()})
        msgs = re.match(r'^/_archive/rooms/([^/]+)/messages$', path)
        if msgs:
            before = int(query.get('before') or 9e15)
            return self.reply(200, {'messages': [x for x in archive_messages(msgs.group(1)) if x['ts'] < before][::-1], 'until': 0})
        if path == '/_archive/search': return self.reply(200, {'results': []})
        return self.reply(200, {})

    def calendar(self, path, query):
        c = WORLD.calendar
        if path == '/_calendar/doc':
            if query.get('have') == str(c['version']): return self.reply(200, {'version': c['version'], 'same': True})
            return self.reply(200, c)
        if path == '/_calendar/ops' and self.command == 'POST':
            for op in (self.body() or {}).get('ops', []):
                cal = next((x for x in c['doc']['calendars'] if x['id'] == op.get('cal')), None)
                if op.get('op') == 'put' and cal:
                    cal['events'] = [e for e in cal['events'] if e['uid'] != op['event']['uid']] + [op['event']]
                elif op.get('op') == 'del' and cal:
                    cal['events'] = [e for e in cal['events'] if e['uid'] != op.get('uid')]
            c['version'] += 1
            return self.reply(200, c)
        return self.reply(404, {'error': 'not in the demo'})

    def feed(self, path, query):
        if path == '/_feed/media':
            n = int(query.get('id', 'demo-0').split('-')[-1])
            bg, fg = FEED_ITEMS[n][6] or ('#0a1512', '#628790')
            return self.reply(200, SVG.format(bg=bg, fg=fg, x=200 + 60 * n).encode(), 'image/svg+xml')
        if path in ('/_feed/doc', '/_feed/refresh', '/_feed/window', '/_feed/settings', '/_feed/policy'): return self.reply(200, feed_doc())
        if path == '/_feed/window/close': return self.reply(200, feed_doc())
        return self.reply(404, {'error': 'not in the demo'})


def main():
    global WORLD
    ap = argparse.ArgumentParser(description='Weft with made-up people and chats, on this computer only.')
    ap.add_argument('--port', type=int, default=8790, help='default 8790; a busy port falls back to a free one')
    args = ap.parse_args()
    WORLD = World()
    try: server = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    except OSError: server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    args.port = server.server_address[1]
    server.daemon_threads = True
    print(f'Weft demo: open http://127.0.0.1:{args.port}/demo   (Ctrl+C stops it; everything here is made up)', flush=True)
    try: server.serve_forever()
    except KeyboardInterrupt: pass


if __name__ == '__main__':
    main()
