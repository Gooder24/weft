Subject: [PATCH 5/8] archivefetch: the message type decides what is kept (an
 Instagram voice clip is video/mp4)

---
 pkg/msgconv/mediadl/archive.go | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/pkg/msgconv/mediadl/archive.go b/pkg/msgconv/mediadl/archive.go
index 76003f5..dfff8d5 100644
--- a/pkg/msgconv/mediadl/archive.go
+++ b/pkg/msgconv/mediadl/archive.go
@@ -27,7 +27,10 @@ func ArchiveWanted(ctx context.Context, msgType event.MessageType, mime string)
 	if ctx.Value(ContextKeyArchiveOnly) == nil || os.Getenv("ARCHIVE_MEDIA_DIR") == "" || os.Getenv("ARCHIVE_MEDIA_NETWORK") == "" {
 		return false
 	}
-	return msgType == event.MsgImage || msgType == event.MsgVideo || strings.HasPrefix(mime, "image/") || strings.HasPrefix(mime, "video/")
+	if msgType != "" { // a voice message can come as video/mp4: the message type decides
+		return msgType == event.MsgImage || msgType == event.MsgVideo
+	}
+	return strings.HasPrefix(mime, "image/") || strings.HasPrefix(mime, "video/")
 }
 
 // ArchiveSave stores a downloaded attachment content-addressed in ARCHIVE_MEDIA_DIR/ARCHIVE_MEDIA_NETWORK (mode 0600)
-- 
