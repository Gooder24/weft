diff --git a/pkg/msgconv/mediadl/archive.go b/pkg/msgconv/mediadl/archive.go
new file mode 100644
index 0000000..76003f5
--- /dev/null
+++ b/pkg/msgconv/mediadl/archive.go
@@ -0,0 +1,66 @@
+package mediadl
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"go.mau.fi/util/exmime"
+	"maunium.net/go/mautrix/event"
+)
+
+// ArchiveMaxSize: bigger photos and videos of an archive fetch stay at Meta (Weft shows a note).
+const ArchiveMaxSize = 50 * 1024 * 1024
+
+// ArchiveFileKey: in a converted part's Extra, where the archive fetch kept its photo or video
+// (a path under ARCHIVE_MEDIA_DIR, <network>/<sha256>.<ext>).
+const ArchiveFileKey = "fi.weft.archive_file"
+
+// ArchiveWanted tells whether an archive fetch keeps this attachment: a photo or video, when ARCHIVE_MEDIA_DIR is set.
+// Nothing of it goes to Matrix; it is downloaded only because Weft is paging the chat back, as the web client would.
+func ArchiveWanted(ctx context.Context, msgType event.MessageType, mime string) bool {
+	if ctx.Value(ContextKeyArchiveOnly) == nil || os.Getenv("ARCHIVE_MEDIA_DIR") == "" || os.Getenv("ARCHIVE_MEDIA_NETWORK") == "" {
+		return false
+	}
+	return msgType == event.MsgImage || msgType == event.MsgVideo || strings.HasPrefix(mime, "image/") || strings.HasPrefix(mime, "video/")
+}
+
+// ArchiveSave stores a downloaded attachment content-addressed in ARCHIVE_MEDIA_DIR/ARCHIVE_MEDIA_NETWORK (mode 0600)
+// and returns its path under ARCHIVE_MEDIA_DIR and its size.
+func ArchiveSave(r io.Reader, mime string) (string, int64, error) {
+	network := filepath.Base(os.Getenv("ARCHIVE_MEDIA_NETWORK"))
+	dir := filepath.Join(os.Getenv("ARCHIVE_MEDIA_DIR"), network)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return "", 0, err
+	}
+	tmp, err := os.CreateTemp(dir, ".fetch-")
+	if err != nil {
+		return "", 0, err
+	}
+	defer os.Remove(tmp.Name())
+	h := sha256.New()
+	n, err := io.Copy(io.MultiWriter(tmp, h), io.LimitReader(r, ArchiveMaxSize+1))
+	if closeErr := tmp.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return "", 0, err
+	} else if n > ArchiveMaxSize {
+		return "", 0, ErrTooLargeFile
+	} else if n == 0 {
+		return "", 0, errors.New("empty file")
+	}
+	name := hex.EncodeToString(h.Sum(nil)) + exmime.ExtensionFromMimetype(mime)
+	dest := filepath.Join(dir, name)
+	if _, err = os.Stat(dest); errors.Is(err, os.ErrNotExist) {
+		if err = os.Link(tmp.Name(), dest); err != nil {
+			return "", 0, err
+		}
+	}
+	return filepath.Join(network, name), n, nil
+}
