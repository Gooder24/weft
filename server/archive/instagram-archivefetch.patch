 	if ctx.Value(ContextKeyArchiveOnly) != nil {
+		// Weft's archive keeps photos and videos (not in Matrix); the rest stays a note.
+		if ArchiveWanted(ctx, content.MsgType, params.MimeType) && (params.FileSize == 0 || params.FileSize <= ArchiveMaxSize) {
