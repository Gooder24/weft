+					extra[ArchiveFileKey] = path
+					content.Info.Size = int(size)
+				}
+			}
+		}
 		fillMetadata()
 		return &bridgev2.ConvertedMessagePart{Type: eventType, Content: content, Extra: extra}, nil
 	}
