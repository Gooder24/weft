diff --git a/pkg/archivefetch/archivefetch.go b/pkg/archivefetch/archivefetch.go
new file mode 100644
index 0000000..5cd142e
--- /dev/null
+++ b/pkg/archivefetch/archivefetch.go
@@ -0,0 +1,186 @@
+// Package archivefetch lets Weft's message archive (asus ~/matrix-spike/archive) read a chat's older history
+// one page at a time, the way the official web client does when someone scrolls up. Nothing is sent to Matrix
+// or to anyone: a page is converted without downloading its media and handed back as text.
+//
+// It only runs when ARCHIVE_FETCH_ADDR is set (a localhost address) and ARCHIVE_FETCH_TOKEN_FILE holds the
+// bearer token the archive sends. One page at a time, at least two seconds apart, whatever the caller does.
+package archivefetch
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/database"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-meta/pkg/msgconv/mediadl"
+)
+
+type Part struct {
+	Kind string `json:"kind"` // the Matrix msgtype, or m.sticker
+	Body string `json:"body"`
+}
+
+type Message struct {
+	ID     string `json:"id"`
+	TS     int64  `json:"ts"`
+	Sender string `json:"sender"`
+	Me     bool   `json:"me"`
+	Parts  []Part `json:"parts"`
+}
+
+type Response struct {
+	Messages []Message `json:"messages"` // oldest first
+	Cursor   string    `json:"cursor"`
+	HasMore  bool      `json:"has_more"`
+}
+
+const minGap = 2 * time.Second
+
+var (
+	lock sync.Mutex
+	last time.Time
+)
+
+type httpError struct {
+	code int
+	err  error
+}
+
+func (e httpError) Error() string { return e.err.Error() }
+
+func Start(br *bridgev2.Bridge) {
+	addr := os.Getenv("ARCHIVE_FETCH_ADDR")
+	if addr == "" {
+		return
+	}
+	log := br.Log.With().Str("component", "archive_fetch").Logger()
+	raw, err := os.ReadFile(os.Getenv("ARCHIVE_FETCH_TOKEN_FILE"))
+	token := strings.TrimSpace(string(raw))
+	if err != nil || token == "" {
+		log.Error().Err(err).Msg("No archive fetch token, not serving")
+		return
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /history", func(w http.ResponseWriter, r *http.Request) {
+		if subtle.ConstantTimeCompare([]byte(r.Header.Get("Authorization")), []byte("Bearer "+token)) != 1 {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		ctx, cancel := context.WithTimeout(log.WithContext(r.Context()), 90*time.Second)
+		defer cancel()
+		resp, err := fetch(ctx, br, r.URL.Query())
+		if err != nil {
+			code := http.StatusBadGateway
+			var he httpError
+			if errors.As(err, &he) {
+				code = he.code
+			}
+			log.Warn().Err(err).Int("status", code).Str("room", r.URL.Query().Get("room")).Msg("Archive fetch failed")
+			http.Error(w, err.Error(), code)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(resp)
+	})
+	go func() {
+		log.Info().Str("addr", addr).Msg("Serving archive fetch")
+		log.Err(http.ListenAndServe(addr, mux)).Msg("Archive fetch server stopped")
+	}()
+}
+
+func fetch(ctx context.Context, br *bridgev2.Bridge, q url.Values) (*Response, error) {
+	portal, err := br.GetPortalByMXID(ctx, id.RoomID(q.Get("room")))
+	if err != nil {
+		return nil, httpError{500, err}
+	} else if portal == nil {
+		return nil, httpError{404, errors.New("not a portal of this bridge")}
+	}
+	user, err := br.GetExistingUserByMXID(ctx, id.UserID(q.Get("user")))
+	if err != nil {
+		return nil, httpError{500, err}
+	} else if user == nil {
+		return nil, httpError{404, errors.New("unknown user")}
+	}
+	login, _, err := portal.FindPreferredLogin(ctx, user, false)
+	if err != nil || login == nil || !login.Client.IsLoggedIn() {
+		return nil, httpError{503, errors.Join(errors.New("not logged in"), err)}
+	}
+	api, ok := login.Client.(bridgev2.BackfillingNetworkAPI)
+	if !ok {
+		return nil, httpError{501, errors.New("network cannot fetch history")}
+	}
+	var anchor *database.Message
+	if beforeID := q.Get("before_id"); beforeID != "" {
+		ts, err := strconv.ParseInt(q.Get("before_ts"), 10, 64)
+		if err != nil {
+			return nil, httpError{400, errors.New("before_ts is a number")}
+		}
+		anchor = &database.Message{ID: networkid.MessageID(beforeID), Timestamp: time.UnixMilli(ts)}
+	} else if anchor, err = br.DB.Message.GetFirstPortalMessage(ctx, portal.PortalKey); err != nil {
+		return nil, httpError{500, err}
+	} else if anchor == nil {
+		return nil, httpError{404, errors.New("chat has no bridged message to start from")}
+	}
+
+	lock.Lock()
+	defer lock.Unlock()
+	if wait := minGap - time.Since(last); wait > 0 {
+		select {
+		case <-time.After(wait):
+		case <-ctx.Done():
+			return nil, httpError{503, ctx.Err()}
+		}
+	}
+	defer func() { last = time.Now() }()
+	res, err := api.FetchMessages(context.WithValue(ctx, mediadl.ContextKeyArchiveOnly, true), bridgev2.FetchMessagesParams{
+		Portal:        portal,
+		Forward:       false,
+		AnchorMessage: anchor,
+		Cursor:        networkid.PaginationCursor(q.Get("cursor")),
+		Count:         50,
+	})
+	if err != nil {
+		return nil, httpError{502, err}
+	}
+	out := &Response{Messages: []Message{}}
+	if res == nil { // the network has nothing more for this chat (or cannot reach further back)
+		return out, nil
+	}
+	out.Cursor, out.HasMore = string(res.Cursor), res.HasMore
+	for _, m := range res.Messages {
+		msg := Message{ID: string(m.ID), TS: m.Timestamp.UnixMilli(), Me: m.Sender.IsFromMe, Parts: []Part{}}
+		if !msg.Me {
+			msg.Sender = string(m.Sender.Sender)
+			if ghost, _ := br.DB.Ghost.GetByID(ctx, m.Sender.Sender); ghost != nil && ghost.Name != "" {
+				msg.Sender = ghost.Name
+			}
+		}
+		if m.ConvertedMessage != nil {
+			for _, p := range m.Parts {
+				if p == nil || p.Content == nil {
+					continue
+				}
+				kind := string(p.Content.MsgType)
+				if p.Type == event.EventSticker {
+					kind = "m.sticker"
+				}
+				msg.Parts = append(msg.Parts, Part{Kind: kind, Body: p.Content.Body})
+			}
+		}
+		out.Messages = append(out.Messages, msg)
+	}
+	return out, nil
+}
