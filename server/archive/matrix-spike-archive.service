[Unit]
Description=matrix-spike: Weft's message archive (older history for chats, 127.0.0.1:29324 behind Caddy's /_archive/)
After=matrix-spike-homeserver.service
Requires=matrix-spike-homeserver.service

[Service]
WorkingDirectory=%h/matrix-spike/archive
ExecStart=/usr/bin/python3 -u %h/matrix-spike/archive/archive.py serve
Restart=always
RestartSec=5
MemoryMax=384M

[Install]
WantedBy=default.target
