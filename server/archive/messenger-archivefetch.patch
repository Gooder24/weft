+
+// archiveFetches: thread ID -> until when reactions in it may belong to a page fetched for the Weft archive.
+var archiveFetches sync.Map
+
+func markArchiveFetch(threadID int64) {
+	archiveFetches.Store(threadID, time.Now().Add(30*time.Second))
+}
+
+// isArchiveReaction tells a reaction that came with an archive page to a message older than anything bridged.
+// bridgev2 would drop it as "target not found" anyway, but only after queueing hundreds of them in the portal.
+func (m *MetaClient) isArchiveReaction(tk handlerParams, messageID string) bool {
+	until, ok := archiveFetches.Load(tk.ID)
+	if !ok || time.Now().After(until.(time.Time)) {
+		return false
+	}
+	msg, err := m.Main.Bridge.DB.Message.GetFirstPartByID(tk.ctx, m.UserLogin.ID, metaid.MakeFBMessageID(messageID))
+	return err == nil && msg == nil
+}
