# x270: pulls the copy of every Weft message that asus archive.py writes hourly to ~/matrix-spike/archive/local.
# Install: ~/.config/systemd/user/, then `systemctl --user enable --now weft-spravy.timer`.
[Unit]
Description=Weft: kópia všetkých správ z asusu do ~/osobné/Weft správy
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/bin/mkdir -p "%h/osobné/Weft správy"
ExecStart=/usr/bin/rsync -a --delete -e "ssh -o BatchMode=yes -o ConnectTimeout=15" asus:matrix-spike/archive/local/ "%h/osobné/Weft správy/"
