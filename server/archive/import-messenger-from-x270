#!/usr/bin/env bash
# Run on asus after deploying archive.py and import_messenger.py beside this script.
# Copies the original export, verifies its hash, imports it and refreshes x270's offline copy.
set -euo pipefail
umask 077
cd "$(dirname "$0")"
archive_dir=$PWD
export_dir=$HOME/exports/messenger
mkdir -p "$export_dir"
zip=$export_dir/messages-$(date +%Y%m%d).zip
report=${zip%.zip}-import.json
exec 9>"$archive_dir/.messenger-import.lock"
flock -n 9 || { echo 'Another Messenger import is running.' >&2; exit 1; }

ssh_args='ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=2'
rsync -a --partial --partial-dir=.rsync-partial --backup --suffix=".bak-$(date +%s)" \
  --chmod=F600 -e "$ssh_args" x270:Downloads/messages.zip "$zip"
source_hash=$($ssh_args x270 'sha256sum ~/Downloads/messages.zip' | cut -d' ' -f1)
copy_hash=$(sha256sum "$zip" | cut -d' ' -f1)
[ "$source_hash" = "$copy_hash" ] || { echo 'The copied export does not match the original.' >&2; exit 1; }
printf 'ZIP verified: %s\n' "$copy_hash"
python3 "$archive_dir/import_messenger.py" "$zip" --dry-run

# Stop only the archive HTTP/mirror service during the database/local snapshot update.
# Matrix and all bridges continue running. Restore its previous state on failure too.
was_active=0
restore() {
  if [ "$was_active" = 1 ]; then systemctl --user start matrix-spike-archive.service; fi
}
trap restore EXIT
if systemctl --user is-active --quiet matrix-spike-archive.service; then
  was_active=1
  systemctl --user stop matrix-spike-archive.service
fi
python3 "$archive_dir/import_messenger.py" "$zip" | tee "$report"
python3 "$archive_dir/archive.py" local
restore
trap - EXIT
$ssh_args x270 'systemctl --user start weft-spravy.service'
printf 'Imported; x270 offline copy refreshed. Report: %s\n' "$report"
