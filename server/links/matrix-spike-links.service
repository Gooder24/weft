[Unit]
Description=matrix-spike: Weft's link reader (what shared links point to, /_links/)
After=matrix-spike-homeserver.service

[Service]
WorkingDirectory=%h/matrix-spike/links
ExecStart=/usr/bin/python3 -I -u %h/matrix-spike/links/links.py
Restart=always
RestartSec=5
MemoryMax=96M

[Install]
WantedBy=default.target
