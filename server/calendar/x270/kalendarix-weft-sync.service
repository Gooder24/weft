# x270: Kalendarix's calendars.json <-> Weft's calendar on asus (server/calendar/kalendar.py).
# Install: copy this, the .timer and kalendarix-weft-sync.py to ~/.config/systemd/user/ and
# `systemctl --user enable --now kalendarix-weft-sync.timer`.
[Unit]
Description=Kalendarix: zladenie s kalendárom vo Wefte (asus)
After=network-online.target

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/python3 %h/.config/systemd/user/kalendarix-weft-sync.py
