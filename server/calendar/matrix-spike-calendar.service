[Unit]
Description=matrix-spike: Weft's calendar (master copy of Kalendarix's calendars.json, /_calendar/)
After=matrix-spike-homeserver.service

[Service]
WorkingDirectory=%h/matrix-spike/calendar
ExecStart=/usr/bin/python3 -I -u %h/matrix-spike/calendar/kalendar.py
Restart=always
RestartSec=5
MemoryMax=64M

[Install]
WantedBy=default.target
