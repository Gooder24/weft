[Unit]
Description=matrix-spike: Weft's calendar (master copy of Kalendarix's calendars.json in Postgres, /_calendar/)
After=matrix-spike-homeserver.service

[Service]
WorkingDirectory=%h/matrix-spike/calendar
ExecStart=%h/.local/bin/node %h/matrix-spike/calendar/kalendar.ts
Restart=always
RestartSec=5
MemoryMax=160M

[Install]
WantedBy=default.target
