# Rebuilds the people map (sk.karchi.friends) from the history. Installed on asus in ~/.config/systemd/user/.
[Unit]
Description=Weft people map
After=matrix-spike-homeserver.service

[Service]
Type=oneshot
WorkingDirectory=%h/matrix-spike/people
ExecStart=/usr/bin/python3 %h/matrix-spike/people/people.py
MemoryMax=512M
Nice=10
