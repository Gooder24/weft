[Unit]
Description=matrix-spike: Weft's send later (sends scheduled messages when they come due)
After=matrix-spike-homeserver.service
Requires=matrix-spike-homeserver.service

[Service]
WorkingDirectory=%h/matrix-spike/sendlater
ExecStart=/usr/bin/python3 -u %h/matrix-spike/sendlater/sendlater.py
Restart=always
RestartSec=5
MemoryMax=64M

[Install]
WantedBy=default.target
