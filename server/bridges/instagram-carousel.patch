From 49869d2a3d60d54892bda191e4fa2395b24a371e Mon Sep 17 00:00:00 2001
From: Gooder24 <162874774+Gooder24@users.noreply.github.com>
Date: Fri, 20 Nov 2026 00:38:39 +0100
Subject: [PATCH] igconv: bridge every photo and video of a shared carousel
 post

Reuploads each item when the post is fetched and lists them in
com.beeper.meta.carousel, the shape of the upstream branch
iFixRobots/ig-carousel-share (which needs direct media).
---
 pkg/msgconv/igconv/xma.go | 61 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 59 insertions(+), 2 deletions(-)

diff --git a/pkg/msgconv/igconv/xma.go b/pkg/msgconv/igconv/xma.go
index 9542423..d2dd01b 100644
--- a/pkg/msgconv/igconv/xma.go
+++ b/pkg/msgconv/igconv/xma.go
@@ -322,19 +322,76 @@ func (mc *MessageConverter) fetchXMAMedia(
 		return nil, "empty response", fmt.Errorf("no items found in XMA media fetch response")
 	}
 	targetItem := resp.Items[0]
+	carousel := targetItem.CarouselMedia
 	if carouselMediaID != "" {
-		for _, subitem := range targetItem.CarouselMedia {
+		for _, subitem := range carousel {
 			if strings.Contains(subitem.ID, carouselMediaID) {
 				targetItem = subitem
 				break
 			}
 		}
 	}
-	return mc.wrapXMAItem(ctx, targetItem, targetURL.String(), baseContent, baseDirectMediaMeta, &mediadl.MediaRefreshMeta{
+	part, status, err := mc.wrapXMAItem(ctx, targetItem, targetURL.String(), baseContent, baseDirectMediaMeta, &mediadl.MediaRefreshMeta{
 		XMATargetID:     targetID,
 		XMAShortcode:    mediaShortcode,
 		CarouselMediaID: carouselMediaID,
 	})
+	if err == nil && !mc.DirectMedia && len(carousel) > 1 {
+		mc.addXMACarousel(ctx, part, carousel, targetItem)
+	}
+	return part, status, err
+}
+
+// XMACarousel lists every photo and video of a shared carousel post in its order, in the same shape as the
+// upstream branch iFixRobots/ig-carousel-share (com.beeper.meta.carousel), so clients can show them all.
+type XMACarousel struct {
+	Items []*event.MessageEventContent `json:"items"`
+}
+
+// addXMACarousel reuploads each item of a shared carousel post (the shared one is already in part). An item that
+// fails is left out; with fewer than two left the post stays a single picture.
+func (mc *MessageConverter) addXMACarousel(ctx context.Context, part *bridgev2.ConvertedMessagePart, carousel []*responses.Items, sharedItem *responses.Items) {
+	items := make([]*event.MessageEventContent, 0, len(carousel))
+	for i, item := range carousel {
+		if item == sharedItem {
+			items = append(items, &event.MessageEventContent{MsgType: part.Content.MsgType, URL: part.Content.URL, File: part.Content.File, Info: part.Content.Info})
+			continue
+		}
+		params := xmaItemReuploadParams(item)
+		params.MaxFileSize = mc.MaxFileSize
+		itemPart, err := mediadl.ReuploadFileToMatrix(ctx, params)
+		if err != nil || (itemPart.Content.URL == "" && itemPart.Content.File == nil) {
+			zerolog.Ctx(ctx).Warn().Err(err).Int("carousel_index", i).Msg("Failed to reupload XMA carousel item")
+			continue
+		}
+		items = append(items, &event.MessageEventContent{MsgType: itemPart.Content.MsgType, URL: itemPart.Content.URL, File: itemPart.Content.File, Info: itemPart.Content.Info})
+	}
+	if len(items) > 1 {
+		part.Extra["com.beeper.meta.carousel"] = &XMACarousel{Items: items}
+	}
+}
+
+// xmaItemReuploadParams picks an item's largest video, or else its largest picture.
+func xmaItemReuploadParams(item *responses.Items) mediadl.ReuploadParams {
+	params := mediadl.ReuploadParams{AttachmentType: table.AttachmentTypeVideo}
+	for _, video := range item.VideoVersions {
+		if video.Width*video.Height > params.Width*params.Height {
+			params.URL = video.URL
+			params.Width = video.Width
+			params.Height = video.Height
+		}
+	}
+	if params.URL == "" {
+		params.AttachmentType = table.AttachmentTypeImage
+		for _, image := range item.ImageVersions2.Candidates {
+			if image.Width*image.Height > params.Width*params.Height {
+				params.URL = image.URL
+				params.Width = image.Width
+				params.Height = image.Height
+			}
+		}
+	}
+	return params
 }
 
