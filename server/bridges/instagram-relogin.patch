From fee6b24cf05d6abe7296ee9cec6453c0482acb9f Mon Sep 17 00:00:00 2001
From: Gooder24 <162874774+Gooder24@users.noreply.github.com>
Date: Wed, 11 Nov 2026 16:39:31 +0100
Subject: [PATCH] igconnector: refuse another account when reconnecting an
 Instagram login

---
 pkg/igconnector/login.go | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/pkg/igconnector/login.go b/pkg/igconnector/login.go
index 92564e8..93e5525 100644
--- a/pkg/igconnector/login.go
+++ b/pkg/igconnector/login.go
@@ -67,9 +67,24 @@ func (ic *IGConnector) GetLoginFlows() []bridgev2.LoginFlow {
 type MetaCookieLogin struct {
 	User *bridgev2.User
 	Main *IGConnector
+	// Override is the login being reconnected (login_id on /login/start). Cookies of another account
+	// are refused, because finishing with a different login ID would delete this one.
+	Override *bridgev2.UserLogin
 }
 
 var _ bridgev2.LoginProcessCookies = (*MetaCookieLogin)(nil)
+var _ bridgev2.LoginProcessWithParams = (*MetaCookieLogin)(nil)
+
+var errWrongAccount = bridgev2.RespError{
+	ErrCode:    "SK.KARCHI.WRONG_ACCOUNT",
+	Err:        "These cookies belong to a different Instagram account than the login being reconnected",
+	StatusCode: http.StatusBadRequest,
+}
+
+func (m *MetaCookieLogin) StartWithParams(ctx context.Context, params bridgev2.LoginStartParams) (*bridgev2.LoginStep, error) {
+	m.Override = params.Override
+	return m.Start(ctx)
+}
 
 func cookieListToFields(cookies []cookies.MetaCookieName, domain string, required bool) []bridgev2.LoginCookieField {
 	fields := make([]bridgev2.LoginCookieField, len(cookies))
@@ -259,5 +274,11 @@ func submitInstagramCookies(ctx context.Context, conn *IGConnector, user *bridge
 }
 
 func (m *MetaCookieLogin) SubmitCookies(ctx context.Context, strCookies map[string]string) (*bridgev2.LoginStep, error) {
+	if m.Override != nil {
+		// The login ID is the Messenger-side FBID, so the Instagram ID stored with the login is what matches ds_user_id.
+		if meta, ok := m.Override.Metadata.(*metaid.UserLoginMetadata); ok && meta.IGID != "" && strCookies[string(cookies.IGCookieDSUserID)] != meta.IGID {
+			return nil, errWrongAccount
+		}
+	}
 	return submitInstagramCookies(ctx, m.Main, m.User, strCookies)
 }
-- 
