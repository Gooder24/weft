+func TestWeftContactList(t *testing.T) {
+	rel := map[string]string{"f1": "friend", "o1": "outgoing", "b1": "blocked"}
+	portals := []*database.Portal{
+		{Key: database.PortalKey{ChannelID: "c1", Receiver: "me"}, Type: discordgo.ChannelTypeDM, OtherUserID: "f1", MXID: "!room1"},
+		{Key: database.PortalKey{ChannelID: "c2", Receiver: "me"}, Type: discordgo.ChannelTypeDM, OtherUserID: "s1"},
+		{Key: database.PortalKey{ChannelID: "g1", Receiver: "me"}, Type: discordgo.ChannelTypeGroupDM},
+	}
+	puppets := map[string]*database.Puppet{"f1": {ID: "f1", Name: "Friend", Username: "friend"}, "s1": {ID: "s1", GlobalName: "Stranger", Username: "stranger", IsBot: false}}
+	users := map[string]*discordgo.User{"o1": {ID: "o1", Username: "out", GlobalName: "Outgoing"}}
+	list := weftContactList(rel, portals, func(id string) *database.Puppet { return puppets[id] }, users)
+	got := map[string]*weftContact{}
+	for _, c := range list {
+		if got[c.ID] != nil {
+			t.Fatalf("%s twice", c.ID)
+		}
+		got[c.ID] = c
+	}
+	if len(got) != 4 {
+		t.Fatalf("want f1, o1, b1, s1; got %v", got)
+	}
+	if c := got["f1"]; c.Relationship != "friend" || c.DMChannel != "c1" || c.DMRoomMXID != "!room1" || c.Name != "Friend" {
+		t.Errorf("friend with a bridged DM: %+v", c)
+	}
+	if c := got["s1"]; c.Relationship != "none" || c.DMChannel != "c2" || c.DMRoomMXID != "" || c.Name != "Stranger" {
+		t.Errorf("non-friend with an unbridged DM: %+v", c)
+	}
+	if c := got["o1"]; c.Relationship != "outgoing" || c.Name != "Outgoing" || c.DMChannel != "" {
+		t.Errorf("outgoing request without DM, named from READY: %+v", c)
+	}
+	if c := got["b1"]; c.Relationship != "blocked" || c.Name != "" {
+		t.Errorf("blocked, unknown name: %+v", c)
+	}
+}
+
+func TestWeftEventKeepsOneSession(t *testing.T) {
+	user := &User{User: &database.User{}}
+	old, cur := &discordgo.Session{}, &discordgo.Session{}
+	ready := func(account string, rel ...*discordgo.Relationship) *discordgo.Ready {
+		return &discordgo.Ready{User: &discordgo.User{ID: account}, Relationships: rel}
+	}
+	user.weftUse(old)
+	user.weftEvent(old, ready("a1", &discordgo.Relationship{ID: "x", Type: discordgo.RelationshipFriend}))
+	user.weftUse(cur)
+	user.weftEvent(cur, ready("a2", &discordgo.Relationship{ID: "y", Type: discordgo.RelationshipFriend}))
+	// A late READY or event of the old session after the new one changes nothing.
+	user.weftEvent(old, &discordgo.Ready{User: &discordgo.User{ID: "a1"}, RequiredAction: "old"})
+	user.weftEvent(old, &discordgo.RelationshipAdd{Relationship: &discordgo.Relationship{ID: "x", Type: discordgo.RelationshipFriend}})
+	user.weftEvent(old, &discordgo.RelationshipRemove{Relationship: &discordgo.Relationship{ID: "y"}})
+	user.weftEvent(cur, &discordgo.RelationshipAdd{Relationship: &discordgo.Relationship{ID: "z", Type: discordgo.RelationshipOutgoingFriendRequest}})
+	user.weftEvent(cur, &discordgo.UserRequiredActionUpdate{RequiredAction: "x"})
+	s := user.weft()
+	if s.account != "a2" || len(s.rel) != 2 || s.rel["y"] != discordgo.RelationshipFriend || s.rel["z"] != discordgo.RelationshipOutgoingFriendRequest {
+		t.Fatalf("view mixes sessions: account %s rel %v", s.account, s.rel)
+	}
+	// Not the bridge's current session or account: not known.
+	user.Session, user.DiscordID = old, "a2"
+	if _, _, _, _, ok := user.weftNow(); ok {
+		t.Error("an old session must not answer")
+	}
+	user.Session, user.DiscordID = cur, "a2"
+	if account, action, rel, _, ok := user.weftNow(); !ok || account != "a2" || action != "x" || rel["y"] != "friend" || rel["z"] != "outgoing" {
+		t.Errorf("current view: %v %v %v %v", ok, account, action, rel)
+	}
+}
