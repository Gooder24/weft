+	"maunium.net/go/maulogger/v2"
+	"maunium.net/go/mautrix/appservice"
+	"maunium.net/go/mautrix/bridge"
+	"maunium.net/go/mautrix/bridge/bridgeconfig"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/config"
+	"go.mau.fi/mautrix-discord/database"
+)
+
+// weftFake is a bridge with a real database (SQLite in memory), a fake homeserver and a fake Discord: every request
+// the bridge makes to Discord lands in `discord`, nothing leaves the machine.
+type weftFake struct {
+	br      *DiscordBridge
+	user    *User
+	mu      sync.Mutex
+	discord []string // "METHOD /path" of each request to Discord
+	reply   func(w http.ResponseWriter, r *http.Request)
+}
+
+func (f *weftFake) requests() []string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]string(nil), f.discord...)
+}
+
+func newWeftFake(t *testing.T) *weftFake {
+	t.Helper()
+	f := &weftFake{}
+	dc := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		f.discord = append(f.discord, r.Method+" "+r.URL.Path)
+		reply := f.reply
+		f.mu.Unlock()
+		if reply != nil {
+			reply(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"id":"9000","channel_id":"100","content":"x"}`)
+	}))
+	t.Cleanup(dc.Close)
+	hs := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if strings.Contains(r.URL.Path, "/event/") { // a thread root, read before a thread is started
+			_, _ = io.WriteString(w, `{"type":"m.room.message","event_id":"$root","room_id":"!room","sender":"@x:example","content":{"msgtype":"m.text","body":"root"}}`)
+			return
+		}
+		_, _ = io.WriteString(w, `{}`)
+	}))
+	t.Cleanup(hs.Close)
+
+	base, err := dbutil.NewWithDialect(fmt.Sprintf("file:%s?mode=memory&cache=shared&_txlock=immediate", strings.ReplaceAll(t.Name(), "/", "_")), "sqlite3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = base.Close() })
+	db := database.New(base, maulogger.Create())
+	if err = db.Upgrade(); err != nil {
+		t.Fatal(err)
+	}
+	nop := zerolog.Nop()
+	as := appservice.Create()
+	as.HomeserverDomain = "example"
+	as.Registration = &appservice.Registration{AppToken: "as", SenderLocalpart: "discordbot", ServerToken: "hs"}
+	if err = as.SetHomeserverURL(hs.URL); err != nil {
+		t.Fatal(err)
+	}
+	baseCfg := &bridgeconfig.BaseConfig{}
+	baseCfg.Homeserver.Domain = "example"
+	f.br = &DiscordBridge{
+		Bridge:                      bridge.Bridge{AS: as, Bot: as.BotIntent(), Config: *baseCfg, ZLog: &nop, Log: maulogger.Create()},
+		Config:                      &config.Config{BaseConfig: baseCfg},
+		DB:                          db,
+		usersByMXID:                 map[id.UserID]*User{},
+		usersByID:                   map[string]*User{},
+		portalsByMXID:               map[id.RoomID]*Portal{},
+		portalsByID:                 map[database.PortalKey]*Portal{},
+		threadsByID:                 map[string]*Thread{},
+		threadsByRootMXID:           map[id.EventID]*Thread{},
+		threadsByCreationNoticeMXID: map[id.EventID]*Thread{},
+		guildsByID:                  map[string]*Guild{},
+		guildsByMXID:                map[id.RoomID]*Guild{},
+		puppets:                     map[string]*Puppet{},
+		puppetsByCustomMXID:         map[id.UserID]*Puppet{},
+	}
+	to, _ := url.Parse(dc.URL)
+	session, _ := discordgo.New("fake-token")
+	session.IsUser = true
+	session.Client = &http.Client{Transport: redirect{to}}
+	dbUser := db.User.New()
+	dbUser.MXID, dbUser.DiscordID = "@karchi:example", "me"
+	f.user = &User{User: dbUser, bridge: f.br, Session: session, log: nop}
+	return f
+}
+
+// guildPortal: a bridged text channel 100 of server 1, with message $known (Discord 500) in the channel and $inThread
+// (Discord 501) in its thread 600.
+func (f *weftFake) guildPortal(t *testing.T) *Portal {
+	t.Helper()
+	dbPortal := f.br.DB.Portal.New()
+	dbPortal.Key = database.NewPortalKey("100", "")
+	dbPortal.Type, dbPortal.GuildID, dbPortal.MXID = discordgo.ChannelTypeGuildText, "1", "!room"
+	dbPortal.Insert()
+	for _, m := range []struct{ mxid, dcid, thread string }{{"$known", "500", ""}, {"$inThread", "501", "600"}, {"$root", "502", ""}} {
+		msg := f.br.DB.Message.New()
+		msg.Channel, msg.DiscordID, msg.MXID, msg.ThreadID, msg.SenderID = dbPortal.Key, m.dcid, id.EventID(m.mxid), m.thread, "other"
+		msg.Insert()
+	}
+	return f.br.GetExistingPortalByID(dbPortal.Key)
+}
+
+func weftEvt(t *testing.T, relates map[string]any) *event.Event {
+	t.Helper()
+	raw := map[string]any{"msgtype": "m.text", "body": "hi"}
+	if relates != nil {
+		raw["m.relates_to"] = relates
+	}
+	data, _ := json.Marshal(raw)
+	evt := &event.Event{Type: event.EventMessage, ID: "$new", RoomID: "!room", Sender: "@karchi:example", Content: event.Content{VeryRaw: data}}
+	if err := evt.Content.ParseRaw(evt.Type); err != nil {
+		t.Fatal(err)
+	}
+	return evt
+}
+
+func TestWeftReplyGuardSendsNothing(t *testing.T) {
+	inReplyTo := func(to string) map[string]any { return map[string]any{"m.in_reply_to": map[string]any{"event_id": to}} }
+	for name, relates := range map[string]map[string]any{
+		"unknown target":            inReplyTo("$nobody"),
+		"target in another thread":  inReplyTo("$inThread"),
+		"in a thread, target not":   {"rel_type": "m.thread", "event_id": "$inThread", "is_falling_back": false, "m.in_reply_to": map[string]any{"event_id": "$known"}},
+		"thread that did not start": {"rel_type": "m.thread", "event_id": "$root", "is_falling_back": true, "m.in_reply_to": map[string]any{"event_id": "$root"}},
+		"thread without an id":      {"rel_type": "m.thread", "event_id": "$root", "is_falling_back": true, "m.in_reply_to": map[string]any{"event_id": "$root"}},
+		// refused before Discord is asked to start the thread
+		"new thread, unknown target":  {"rel_type": "m.thread", "event_id": "$root", "is_falling_back": false, "m.in_reply_to": map[string]any{"event_id": "$nobody"}},
+		"new thread, target its root": {"rel_type": "m.thread", "event_id": "$root", "is_falling_back": false, "m.in_reply_to": map[string]any{"event_id": "$root"}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			f := newWeftFake(t)
+			portal := f.guildPortal(t)
+			if name == "in a thread, target not" {
+				// thread 600 is known to the bridge, rooted at $inThread
+				th := f.br.DB.Thread.New()
+				th.ID, th.ParentID, th.RootDiscordID, th.RootMXID = "600", "100", "501", "$inThread"
+				th.Insert()
+			}
+			if name == "thread that did not start" {
+				f.reply = func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusForbidden) }
+			}
+			if name == "thread without an id" {
+				f.reply = func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(`{}`)) }
+			}
+			portal.handleMatrixMessage(f.user, weftEvt(t, relates))
+			if name == "thread without an id" {
+				portal.handleMatrixMessage(f.user, weftEvt(t, relates)) // the next one in that thread is not sent either
+			}
+			for _, req := range f.requests() {
+				if strings.HasSuffix(req, "/messages") {
+					t.Fatalf("a refused message reached Discord: %v", f.requests())
+				}
+			}
+			if !strings.HasPrefix(name, "thread ") && len(f.requests()) != 0 {
+				t.Fatalf("no request at all expected: %v", f.requests())
+			}
+		})
+	}
+}
+
+func TestWeftReplyGuardLetsOneThrough(t *testing.T) {
+	for name, relates := range map[string]map[string]any{
+		"no reply":             {},
+		"reply in the channel": {"m.in_reply_to": map[string]any{"event_id": "$known"}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			f := newWeftFake(t)
+			portal := f.guildPortal(t)
+			portal.handleMatrixMessage(f.user, weftEvt(t, relates))
+			if got := f.requests(); len(got) != 1 || got[0] != "POST /api/v9/channels/100/messages" {
+				t.Fatalf("want exactly one message to the channel, got %v", got)
+			}
+		})
+	}
+}
+
+func TestWeftRefusalNotice(t *testing.T) {
+	for _, err := range []error{errWeftReplyUnknown, errWeftReplyThread, fmt.Errorf("%w: error starting thread: 403", errWeftThreadFailed)} {
+		_, status, certain, notice, human, _ := errorToStatusReason(err)
+		if status != event.MessageStatusFail || !certain || !notice || human == "" || strings.Contains(human, "403") {
+			t.Errorf("%v: %v %v %v %q", err, status, certain, notice, human)
+		}
+	}
+}
