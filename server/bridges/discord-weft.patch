@@ -0,0 +1,159 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"github.com/gorilla/mux"
+	"github.com/rs/zerolog"
+	"gopkg.in/yaml.v3"
+	"maunium.net/go/maulogger/v2"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+// ready: the fake user's session got READY for Discord account "me".
+func (f *weftFake) ready() {
+	f.user.DiscordToken = "token"
+	f.user.Insert()
+	f.user.weftUse(f.user.Session)
+	f.user.weftEvent(f.user.Session, &discordgo.Ready{User: &discordgo.User{ID: "me"}})
+}
+
+func (f *weftFake) portalRow(channel, receiver string, kind discordgo.ChannelType, room id.RoomID) {
+	row := f.br.DB.Portal.New()
+	row.Key, row.Type, row.MXID = database.NewPortalKey(channel, receiver), kind, room
+	if kind == discordgo.ChannelTypeGuildText {
+		row.GuildID = "1"
+	}
+	row.Insert()
+}
+
+// serve: one provisioning request as Karchi; the status and the decoded body.
+func (f *weftFake) serve(t *testing.T, method, path string, route string, handler func(*ProvisioningAPI) http.HandlerFunc) (int, map[string]any) {
+	t.Helper()
+	p := &ProvisioningAPI{bridge: f.br, log: maulogger.Create()}
+	r := mux.NewRouter()
+	r.HandleFunc(route, handler(p)).Methods(method)
+	req := httptest.NewRequest(method, path, nil)
+	req = req.WithContext(context.WithValue(req.Context(), "user", f.user))
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, req)
+	body := map[string]any{}
+	_ = json.Unmarshal(rec.Body.Bytes(), &body)
+	return rec.Code, body
+}
+
+func TestWeftOwnChannel(t *testing.T) {
+	f := newWeftFake(t)
+	f.ready()
+	f.portalRow("10", "me", discordgo.ChannelTypeDM, "")
+	f.portalRow("11", "someone", discordgo.ChannelTypeDM, "")
+	f.portalRow("12", "", discordgo.ChannelTypeGroupDM, "")
+	f.portalRow("13", "", discordgo.ChannelTypeGroupDM, "")
+	f.portalRow("14", "", discordgo.ChannelTypeGuildText, "")
+	f.user.MarkInPortal(database.UserPortal{DiscordID: "12", Type: database.UserPortalTypeDM, Timestamp: time.Now()})
+	db := f.br.DB
+	for channel, want := range map[string]int{"10": 0, "11": http.StatusNotFound, "12": 0, "13": http.StatusNotFound, "14": http.StatusNotFound, "99": http.StatusNotFound} {
+		if row, got := weftOwnChannel(db, f.user, "me", channel); got != want || (want == 0) != (row != nil) {
+			t.Errorf("channel %s: %d %v, want %d", channel, got, row, want)
+		}
+	}
+	other := db.User.New()
+	other.MXID, other.DiscordID, other.DiscordToken = "@other:example", "them", "token2"
+	other.Insert()
+	if _, got := weftOwnChannel(db, f.user, "me", "12"); got != http.StatusConflict {
+		t.Errorf("a group while another account is logged in: %d", got)
+	}
+	if _, got := weftOwnChannel(db, f.user, "me", "10"); got != 0 {
+		t.Errorf("a DM is still his with another account logged in: %d", got)
+	}
+}
+
+func TestWeftOpen(t *testing.T) {
+	open := func(p *ProvisioningAPI) http.HandlerFunc { return p.weftOpen }
+	route := "/v1/channels/{channelID}/open"
+	f := newWeftFake(t)
+	if code, _ := f.serve(t, "POST", "/v1/channels/10/open", route, open); code != http.StatusServiceUnavailable {
+		t.Fatalf("before READY: %d", code)
+	}
+	f.ready()
+	f.portalRow("10", "me", discordgo.ChannelTypeDM, "!joined")
+	f.portalRow("11", "me", discordgo.ChannelTypeDM, "!left")
+	f.portalRow("12", "someone", discordgo.ChannelTypeDM, "")
+	f.br.AS.StateStore.SetMembership("!joined", f.user.MXID, event.MembershipJoin)
+
+	if code, body := f.serve(t, "POST", "/v1/channels/10/open", route, open); code != 200 || body["state"] != "joined" || body["room_id"] != "!joined" {
+		t.Errorf("a room he is in: %d %v", code, body)
+	}
+	// A room he is not in: invited again on Matrix (the fake homeserver takes it), nothing asked of Discord.
+	if code, body := f.serve(t, "POST", "/v1/channels/11/open", route, open); code != 200 || body["state"] != "invited" || body["room_id"] != "!left" {
+		t.Errorf("a room he left: %d %v", code, body)
+	}
+	if code, _ := f.serve(t, "POST", "/v1/channels/12/open", route, open); code != http.StatusNotFound {
+		t.Errorf("someone else's DM: %d", code)
+	}
+	if code, _ := f.serve(t, "POST", "/v1/channels/x/open", route, open); code != http.StatusBadRequest {
+		t.Errorf("not an id: %d", code)
+	}
+	if got := f.requests(); len(got) != 0 {
+		t.Errorf("Discord was asked: %v", got)
+	}
+	// A channel without a room: its one GET; Discord refusing it ends there, without a room.
+	f.portalRow("13", "me", discordgo.ChannelTypeDM, "")
+	f.reply = func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusForbidden) }
+	if code, _ := f.serve(t, "POST", "/v1/channels/13/open", route, open); code != http.StatusBadGateway {
+		t.Errorf("Discord refusing the channel: %d", code)
+	}
+	if got := f.requests(); len(got) != 1 || got[0] != "GET /api/v9/channels/13" {
+		t.Errorf("want only the channel's GET: %v", got)
+	}
+	// A group whose GET lets a second account sign in meanwhile: refused, no room (it would invite that one too).
+	f.portalRow("14", "", discordgo.ChannelTypeGroupDM, "")
+	f.user.MarkInPortal(database.UserPortal{DiscordID: "14", Type: database.UserPortalTypeDM, Timestamp: time.Now()})
+	f.reply = func(w http.ResponseWriter, r *http.Request) {
+		other := f.br.DB.User.New()
+		other.MXID, other.DiscordID, other.DiscordToken = "@other:example", "them", "token2"
+		other.Insert()
+		_, _ = w.Write([]byte(`{"id":"14","type":3}`))
+	}
+	if code, _ := f.serve(t, "POST", "/v1/channels/14/open", route, open); code != http.StatusConflict {
+		t.Errorf("a second account during the group's GET: %d", code)
+	}
+	if p := f.br.GetExistingPortalByID(database.NewPortalKey("14", "")); p == nil || p.MXID != "" {
+		t.Errorf("a room was made: %v", p)
+	}
+}
+
+// Upstream alone: a group room that exists invites an account that signs in later (READY -> handlePrivateChannel),
+// so weftOpen's group guard can only refuse while another account is logged in. If this fails, upstream stopped
+// inviting later accounts and the guard needs another look.
+func TestWeftLaterAccountIsInvitedByUpstream(t *testing.T) {
+	f := newWeftFake(t)
+	f.ready()
+	if err := yaml.Unmarshal([]byte("username_template: 'discord_{{.}}'\ndisplayname_template: '{{.Username}}'\nchannel_name_template: '{{.Name}}'\nguild_name_template: '{{.Name}}'\n"), &f.br.Config.Bridge); err != nil {
+		t.Fatal(err)
+	}
+	f.portalRow("14", "", discordgo.ChannelTypeGroupDM, "!group")
+	portal := f.br.GetExistingPortalByID(database.NewPortalKey("14", ""))
+	row := f.br.DB.User.New()
+	row.MXID, row.DiscordID, row.DiscordToken = "@other:example", "them", "token2"
+	row.Insert()
+	other := &User{User: row, bridge: f.br, Session: f.user.Session, log: zerolog.Nop()}
+	f.br.usersByMXID[other.MXID], f.br.usersByID["them"] = other, other
+	store := f.br.AS.StateStore
+	if store.IsInvited("!group", other.MXID) {
+		t.Fatal("invited before signing in")
+	}
+	other.handlePrivateChannel(portal, &discordgo.Channel{ID: "14", Type: discordgo.ChannelTypeGroupDM, Name: "g"}, time.Now(), false, false)
+	if !store.IsInvited("!group", other.MXID) {
+		t.Fatal("upstream no longer invites a later account")
+	}
+}
diff --git a/weft_reply.go b/weft_reply.go
new file mode 100644
index 0000000..7332cbc
--- /dev/null
+++ b/weft_reply.go
@@ -0,0 +1,53 @@
+package main
+
+// Weft's reply guard (DISCORD-PLAN.md, point 1, step 4). The stock bridge sends a reply whose target it cannot
+// reference (an unknown message, or one in another Discord thread) as a plain message to the whole channel, and a
+// message for a thread it failed to start into the parent channel. Every Matrix message passes handleMatrixMessage
+// (portal.go), which asks weftReplyCheck before it uploads or sends anything; a refused message goes nowhere and
+// Matrix gets the bridge's usual "⚠ Your message was not bridged: …" notice with one of the texts below (Weft
+// reads them in app.js failReason).
+
+import (
+	"errors"
+
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+var (
+	errWeftReplyUnknown = errors.New("the message you replied to is not on Discord, so the reply was not sent")
+	errWeftReplyThread  = errors.New("the message you replied to is in a Discord thread; answer it in the Discord app")
+	errWeftThreadFailed = errors.New("Discord did not start the thread, so the message was not sent")
+)
+
+// weftRefusal: the guard's own text for a refused message, "" for any other error.
+func weftRefusal(err error) string {
+	for _, e := range []error{errWeftReplyUnknown, errWeftReplyThread, errWeftThreadFailed} {
+		if errors.Is(err, e) {
+			return e.Error()
+		}
+	}
+	return ""
+}
+
+// weftNewThread: the thread of a message that would start one; no row of the bridge is in it.
+const weftNewThread = "\x00new thread"
+
+// weftReplyCheck: nil when the message may go to Discord in thread `threadID` ("" for the channel itself) as far as
+// its reply goes; `target` is the bridge's row of the replied-to event (nil: unknown).
+func weftReplyCheck(content *event.MessageEventContent, target func(id.EventID) *database.Message, threadID string) error {
+	replyTo := content.RelatesTo.GetNonFallbackReplyTo()
+	if replyTo == "" {
+		return nil
+	}
+	msg := target(replyTo)
+	if msg == nil {
+		return errWeftReplyUnknown
+	}
+	if msg.ThreadID != threadID {
+		return errWeftReplyThread
+	}
+	return nil
+}
diff --git a/weft_reply_test.go b/weft_reply_test.go
new file mode 100644
