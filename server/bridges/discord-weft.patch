diff --git a/weft.go b/weft.go
new file mode 100644
index 0000000..7b5aad2
--- /dev/null
+++ b/weft.go
@@ -0,0 +1,235 @@
+package main
+
+// Weft's additions to the legacy Discord bridge (DISCORD-PLAN.md, phases 0 and 1). The two below answer from what
+// the bridge already holds in memory or in its database: no request goes to Discord.
+//
+//	GET /v1/account   whether the friend list is known yet, the account's current required action, and whether
+//	                  "@" may search a server's members (bridge.weft.member_search, weft_members.go)
+//	GET /v1/contacts  friends, friend requests, blocked people and the other person of each DM, with the friendship
+//	                  and the DM channel and room, if any; 503 until the gateway's READY brought the friend list
+//
+// Also Weft's: the reply guard (weft_reply.go), POST /v1/channels/{id}/open (weft_open.go) and
+// GET /v1/guilds/{id}/members (weft_members.go, the one that asks Discord, off by default).
+
+import (
+	"net/http"
+	"sort"
+	"sync"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+// weftState is Weft's own view of one Discord session: what its READY said and the friendship events that came
+// after it on the same session, in the gateway's order (weftEvent runs synchronously in the session's event
+// loop). The bridge's own relationships map is updated from goroutines and from every session, so it is not used.
+type weftState struct {
+	sync.RWMutex
+	session        *discordgo.Session
+	account        string // the Discord account READY was for
+	requiredAction string
+	rel            map[string]discordgo.RelationshipType
+	users          map[string]*discordgo.User // people READY named (friends among them), for their names
+}
+
+var weftStates sync.Map // *User -> *weftState
+
+func (user *User) weft() *weftState {
+	s, _ := weftStates.LoadOrStore(user, &weftState{})
+	return s.(*weftState)
+}
+
+// weftUse: the bridge is about to open `session` (connect, before it can send anything); from now on only its
+// events count, whatever an older session still delivers.
+func (user *User) weftUse(session *discordgo.Session) {
+	s := user.weft()
+	s.Lock()
+	defer s.Unlock()
+	s.session, s.account, s.requiredAction, s.rel, s.users = session, "", "", nil, nil
+}
+
+// weftEvent: called for every event of `session` before the bridge handles it. Events of any session but the one
+// weftUse named are dropped; its READY starts the view over, later events change it.
+func (user *User) weftEvent(session *discordgo.Session, evt any) {
+	s := user.weft()
+	s.Lock()
+	defer s.Unlock()
+	if session != s.session {
+		return
+	}
+	if c, ok := evt.(*discordgo.GuildMembersChunk); ok {
+		user.weftSearch().deliver(c)
+		return
+	}
+	if r, ok := evt.(*discordgo.Ready); ok {
+		s.account, s.requiredAction = "", string(r.RequiredAction)
+		if r.User != nil {
+			s.account = r.User.ID
+		}
+		s.rel = make(map[string]discordgo.RelationshipType, len(r.Relationships))
+		for _, x := range r.Relationships {
+			if x != nil {
+				s.rel[x.ID] = x.Type
+			}
+		}
+		s.users = make(map[string]*discordgo.User, len(r.Users))
+		for _, u := range r.Users {
+			if u != nil {
+				s.users[u.ID] = u
+			}
+		}
+		return
+	}
+	if s.rel == nil {
+		return
+	}
+	switch e := evt.(type) {
+	case *discordgo.RelationshipAdd:
+		if e.Relationship != nil {
+			s.rel[e.ID] = e.Type
+		}
+	case *discordgo.RelationshipUpdate:
+		if e.Relationship != nil {
+			s.rel[e.ID] = e.Type
+		}
+	case *discordgo.RelationshipRemove:
+		if e.Relationship != nil {
+			delete(s.rel, e.ID)
+		}
+	case *discordgo.UserRequiredActionUpdate:
+		s.requiredAction = string(e.RequiredAction)
+	}
+}
+
+// weftNow: the view, when it belongs to the bridge's current session (its READY names the account; DiscordID is
+// not read: readyHandler writes it under another lock); ok=false while a login, logout or reconnect is under way.
+func (user *User) weftNow() (account, action string, rel map[string]string, users map[string]*discordgo.User, ok bool) {
+	user.Lock()
+	current := user.Session
+	user.Unlock()
+	s := user.weft()
+	s.RLock()
+	defer s.RUnlock()
+	if s.session == nil || s.session != current || s.account == "" {
+		return "", s.requiredAction, nil, nil, false
+	}
+	rel = make(map[string]string, len(s.rel))
+	for uid, t := range s.rel {
+		if kind, known := weftRelationships[t]; known {
+			rel[uid] = kind
+		}
+	}
+	users = make(map[string]*discordgo.User, len(s.users))
+	for uid, u := range s.users {
+		users[uid] = u
+	}
+	return s.account, s.requiredAction, rel, users, true
+}
+
+type weftAccount struct {
+	Connected          bool   `json:"connected"`
+	RelationshipsReady bool   `json:"relationships_ready"`
+	RequiredAction     string `json:"required_action"`
+	MemberSearch       bool   `json:"member_search"`
+}
+
+func (p *ProvisioningAPI) weftAccount(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	_, action, _, _, ok := user.weftNow()
+	jsonResponse(w, http.StatusOK, weftAccount{Connected: user.Connected(), RelationshipsReady: ok, RequiredAction: action,
+		MemberSearch: p.bridge.Config.Bridge.Weft.MemberSearch})
+}
+
+type weftContact struct {
+	ID           string    `json:"id"`
+	Name         string    `json:"name"`
+	Username     string    `json:"username,omitempty"`
+	AvatarURL    string    `json:"avatar_url,omitempty"`
+	Bot          bool      `json:"bot,omitempty"`
+	Relationship string    `json:"relationship"` // friend | outgoing | incoming | blocked | none
+	DMChannel    string    `json:"dm_channel,omitempty"`
+	DMRoomMXID   id.RoomID `json:"dm_room_mxid,omitempty"`
+}
+
+var weftRelationships = map[discordgo.RelationshipType]string{
+	discordgo.RelationshipFriend:                "friend",
+	discordgo.RelationshipBlocked:               "blocked",
+	discordgo.RelationshipIncomingFriendRequest: "incoming",
+	discordgo.RelationshipOutgoingFriendRequest: "outgoing",
+}
+
+func (p *ProvisioningAPI) weftContacts(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	account, _, rel, users, ok := user.weftNow()
+	if !ok {
+		// Never read as "not a friend": the list is simply not known yet.
+		jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Discord has not sent the friend list yet", ErrCode: "FI.MAU.DISCORD.NOT_READY"})
+		return
+	}
+	list := weftContactList(rel, p.bridge.DB.Portal.FindPrivateChatsOf(account), p.bridge.DB.Puppet.Get, users)
+	jsonResponse(w, http.StatusOK, map[string]any{"contacts": list})
+}
+
+// weftContactList: everyone with a friendship state or a one-to-one DM, each once, by name.
+func weftContactList(rel map[string]string, portals []*database.Portal, puppet func(string) *database.Puppet, users map[string]*discordgo.User) []*weftContact {
+	out := map[string]*weftContact{}
+	add := func(uid string) *weftContact {
+		if c, ok := out[uid]; ok {
+			return c
+		}
+		c := &weftContact{ID: uid, Relationship: "none"}
+		if kind, ok := rel[uid]; ok {
+			c.Relationship = kind
+		}
+		out[uid] = c
+		return c
+	}
+	for uid := range rel {
+		add(uid)
+	}
+	// One-to-one DMs only (a group has no single other person).
+	for _, portal := range portals {
+		if portal.Type != discordgo.ChannelTypeDM || portal.OtherUserID == "" {
+			continue
+		}
+		c := add(portal.OtherUserID)
+		c.DMChannel = portal.Key.ChannelID
+		c.DMRoomMXID = portal.MXID
+	}
+	list := make([]*weftContact, 0, len(out))
+	for uid, c := range out {
+		weftName(c, puppet(uid), users[uid])
+		list = append(list, c)
+	}
+	sort.Slice(list, func(i, j int) bool {
+		return list[i].Name < list[j].Name || (list[i].Name == list[j].Name && list[i].ID < list[j].ID)
+	})
+	return list
+}
+
+// weftName: the bridge's ghost when it has one (read only: GetPuppetByID would create it), else READY's user.
+func weftName(c *weftContact, puppet *database.Puppet, u *discordgo.User) {
+	if puppet != nil {
+		c.Name, c.Username, c.Bot = puppet.Name, puppet.Username, puppet.IsBot
+		if !puppet.AvatarURL.IsEmpty() {
+			c.AvatarURL = puppet.AvatarURL.String()
+		}
+		if c.Name == "" {
+			c.Name = puppet.GlobalName
+		}
+	}
+	if u != nil {
+		if c.Username == "" {
+			c.Username = u.Username
+		}
+		if c.Name == "" {
+			c.Name = u.GlobalName
+		}
+		c.Bot = c.Bot || u.Bot
+	}
+	if c.Name == "" {
+		c.Name = c.Username
+	}
+}
diff --git a/weft_members.go b/weft_members.go
new file mode 100644
index 0000000..958e84a
--- /dev/null
+++ b/weft_members.go
@@ -0,0 +1,197 @@
+package main
+
+// GET /v1/guilds/{guildID}/members?query=<name prefix>&limit=<1..10>: members of one of Karchi's servers whose name
+// starts so, for "@" in Weft (DISCORD-PLAN.md, point 3, step 2). One gateway request (op 8, as discordgo's
+// RequestGuildMembers) per server and prefix, at most 10 members, one search at a time, at least weftSearchGap
+// apart, answers kept weftSearchKeep. Never an empty prefix (the whole list is what scrapers ask for).
+//
+// Off unless bridge.weft.member_search is true; off it answers {"enabled": false, "members": []}.
+// On: {"enabled": true, "members": [{id, name, username, nick, avatar_url, bot}], "timeout": bool}; timeout means
+// Discord sent nothing within weftSearchWait (not kept, asked again next time).
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"github.com/gorilla/mux"
+)
+
+var (
+	weftSearchGap  = time.Second
+	weftSearchWait = 3 * time.Second
+	weftSearchKeep = 10 * time.Minute
+)
+
+const weftSearchLimit = 10
+
+// weftRequestMembers sends the gateway request (a variable for tests).
+var weftRequestMembers = func(session *discordgo.Session, guild, query, nonce string) error {
+	return session.RequestGuildMembers(guild, query, weftSearchLimit, nonce, false)
+}
+
+type weftSearcher struct {
+	sync.Mutex // one search at a time
+	last       time.Time
+	kept       map[string]weftKept
+
+	waitLock sync.Mutex
+	waiting  map[string]chan *discordgo.GuildMembersChunk // nonce -> its search
+}
+
+type weftKept struct {
+	at      time.Time
+	members []*discordgo.Member
+}
+
+var weftSearchers sync.Map // *User -> *weftSearcher
+
+func (user *User) weftSearch() *weftSearcher {
+	s, _ := weftSearchers.LoadOrStore(user, &weftSearcher{kept: map[string]weftKept{}, waiting: map[string]chan *discordgo.GuildMembersChunk{}})
+	return s.(*weftSearcher)
+}
+
+// deliver: a GUILD_MEMBERS_CHUNK of the bridge's current session (weftEvent); chunks of no search are ignored.
+func (s *weftSearcher) deliver(c *discordgo.GuildMembersChunk) {
+	s.waitLock.Lock()
+	defer s.waitLock.Unlock()
+	if ch := s.waiting[c.Nonce]; ch != nil && c.Nonce != "" {
+		select {
+		case ch <- c:
+		default:
+		}
+	}
+}
+
+// search: the members of `guild` starting with `query`, from what was kept or by one `send` with a fresh nonce.
+func (s *weftSearcher) search(guild, query string, send func(nonce string) error) ([]*discordgo.Member, bool, error) {
+	s.Lock()
+	defer s.Unlock()
+	key := guild + "\x00" + strings.ToLower(query)
+	now := time.Now()
+	for k, v := range s.kept {
+		if now.Sub(v.at) > weftSearchKeep {
+			delete(s.kept, k)
+		}
+	}
+	if v, ok := s.kept[key]; ok {
+		return v.members, false, nil
+	}
+	if wait := weftSearchGap - now.Sub(s.last); wait > 0 {
+		time.Sleep(wait)
+	}
+	buf := make([]byte, 8)
+	_, _ = rand.Read(buf)
+	nonce := hex.EncodeToString(buf)
+	ch := make(chan *discordgo.GuildMembersChunk, 4)
+	s.waitLock.Lock()
+	s.waiting[nonce] = ch
+	s.waitLock.Unlock()
+	defer func() {
+		s.waitLock.Lock()
+		delete(s.waiting, nonce)
+		s.waitLock.Unlock()
+	}()
+	s.last = time.Now()
+	if err := send(nonce); err != nil {
+		return nil, false, err
+	}
+	var members []*discordgo.Member
+	timer := time.NewTimer(weftSearchWait)
+	defer timer.Stop()
+	for {
+		select {
+		case c := <-ch:
+			if c.GuildID == guild {
+				members = append(members, c.Members...)
+			}
+			if c.ChunkIndex >= c.ChunkCount-1 {
+				s.kept[key] = weftKept{at: time.Now(), members: members}
+				return members, false, nil
+			}
+		case <-timer.C:
+			return members, true, nil
+		}
+	}
+}
+
+type weftMember struct {
+	ID        string `json:"id"`
+	Name      string `json:"name"`
+	Username  string `json:"username"`
+	Nick      string `json:"nick,omitempty"`
+	AvatarURL string `json:"avatar_url,omitempty"`
+	Bot       bool   `json:"bot,omitempty"`
+}
+
+func weftMemberList(members []*discordgo.Member, account string, limit int) []weftMember {
+	out := []weftMember{}
+	seen := map[string]bool{}
+	for _, m := range members {
+		if m == nil || m.User == nil || m.User.ID == account || seen[m.User.ID] {
+			continue
+		}
+		seen[m.User.ID] = true
+		x := weftMember{ID: m.User.ID, Username: m.User.Username, Nick: m.Nick, Bot: m.User.Bot, Name: m.Nick}
+		if x.Name == "" {
+			x.Name = m.User.GlobalName
+		}
+		if x.Name == "" {
+			x.Name = m.User.Username
+		}
+		if m.User.Avatar != "" {
+			x.AvatarURL = m.User.AvatarURL("")
+		}
+		if out = append(out, x); len(out) == limit {
+			break
+		}
+	}
+	return out
+}
+
+func (p *ProvisioningAPI) weftMembers(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	if !p.bridge.Config.Bridge.Weft.MemberSearch {
+		jsonResponse(w, http.StatusOK, map[string]any{"enabled": false, "members": []weftMember{}})
+		return
+	}
+	guild := mux.Vars(r)["guildID"]
+	query := strings.TrimSpace(r.URL.Query().Get("query"))
+	if !weftChannelID.MatchString(guild) || query == "" || len([]rune(query)) > 32 {
+		jsonResponse(w, http.StatusBadRequest, Error{Error: "A server ID and a name prefix are needed", ErrCode: "M_INVALID_PARAM"})
+		return
+	}
+	limit := weftSearchLimit
+	if l, err := strconv.Atoi(r.URL.Query().Get("limit")); err == nil && l >= 1 && l < limit {
+		limit = l
+	}
+	account, _, _, _, ok := user.weftNow()
+	if !ok {
+		jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Not connected to Discord yet", ErrCode: "FI.MAU.DISCORD.NOT_READY"})
+		return
+	}
+	if !user.IsInPortal(guild) {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Not one of your servers", ErrCode: "M_NOT_FOUND"})
+		return
+	}
+	user.Lock()
+	session := user.Session
+	user.Unlock()
+	members, timeout, err := user.weftSearch().search(guild, query, func(nonce string) error {
+		if session == nil {
+			return errUserNotLoggedIn
+		}
+		return weftRequestMembers(session, guild, query, nonce)
+	})
+	if err != nil {
+		p.log.Warnfln("Weft: member search in %s failed: %v", guild, err)
+		jsonResponse(w, http.StatusBadGateway, Error{Error: "Discord did not take the search", ErrCode: "SK.KARCHI.WEFT.DISCORD"})
+		return
+	}
+	jsonResponse(w, http.StatusOK, map[string]any{"enabled": true, "members": weftMemberList(members, account, limit), "timeout": timeout})
+}
diff --git a/weft_members_test.go b/weft_members_test.go
new file mode 100644
index 0000000..7f982b6
--- /dev/null
+++ b/weft_members_test.go
@@ -0,0 +1,77 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+func TestWeftMembers(t *testing.T) {
+	members := func(p *ProvisioningAPI) http.HandlerFunc { return p.weftMembers }
+	route := "/v1/guilds/{guildID}/members"
+	f := newWeftFake(t)
+	f.ready()
+	f.user.MarkInPortal(database.UserPortal{DiscordID: "1", Type: database.UserPortalTypeGuild, Timestamp: time.Now()})
+	var sent []string
+	request, gap, wait := weftRequestMembers, weftSearchGap, weftSearchWait
+	t.Cleanup(func() { weftRequestMembers, weftSearchGap, weftSearchWait = request, gap, wait })
+	answer := func(nonce string) *discordgo.GuildMembersChunk {
+		var list []*discordgo.Member
+		for _, u := range []*discordgo.User{{ID: "me", Username: "karchi"}, {ID: "2", Username: "jana", GlobalName: "Jana"}, {ID: "3", Username: "janko"}} {
+			list = append(list, &discordgo.Member{User: u})
+		}
+		list = append(list, &discordgo.Member{User: &discordgo.User{ID: "4", Username: "jano"}, Nick: "Janíček"})
+		return &discordgo.GuildMembersChunk{GuildID: "1", Members: list, ChunkCount: 1, Nonce: nonce}
+	}
+	weftRequestMembers = func(session *discordgo.Session, guild, query, nonce string) error {
+		sent = append(sent, guild+" "+query)
+		f.user.weftEvent(session, &discordgo.GuildMembersChunk{GuildID: "1", Nonce: "someone else's", ChunkCount: 1})
+		if query != "silent" {
+			f.user.weftEvent(session, answer(nonce))
+		}
+		return nil
+	}
+	weftSearchGap, weftSearchWait = 50*time.Millisecond, 20*time.Millisecond
+
+	// Off (the default): a plain answer, no request.
+	if code, body := f.serve(t, "GET", "/v1/guilds/1/members?query=ja", route, members); code != 200 || body["enabled"] != false || len(sent) != 0 {
+		t.Fatalf("off: %d %v %v", code, body, sent)
+	}
+	f.br.Config.Bridge.Weft.MemberSearch = true
+	for _, path := range []string{"/v1/guilds/1/members", "/v1/guilds/1/members?query=%20", "/v1/guilds/x/members?query=ja"} {
+		if code, _ := f.serve(t, "GET", path, route, members); code != http.StatusBadRequest {
+			t.Errorf("%s: %d", path, code)
+		}
+	}
+	if code, _ := f.serve(t, "GET", "/v1/guilds/7/members?query=ja", route, members); code != http.StatusNotFound {
+		t.Errorf("a server he is not on: %d", code)
+	}
+	code, body := f.serve(t, "GET", "/v1/guilds/1/members?query=ja&limit=50", route, members)
+	list, _ := body["members"].([]any)
+	if code != 200 || body["enabled"] != true || body["timeout"] != false || len(list) != 3 {
+		t.Fatalf("search: %d %v", code, body)
+	}
+	if first := list[0].(map[string]any); first["id"] != "2" || first["name"] != "Jana" {
+		t.Errorf("first: %v", first)
+	}
+	if last := list[2].(map[string]any); last["name"] != "Janíček" || last["username"] != "jano" {
+		t.Errorf("a nickname is the name: %v", last)
+	}
+	// The same prefix again (any case) comes from what was kept; the limit cuts.
+	if _, body = f.serve(t, "GET", "/v1/guilds/1/members?query=JA&limit=1", route, members); len(body["members"].([]any)) != 1 || len(sent) != 1 {
+		t.Errorf("kept: %v %v", body, sent)
+	}
+	// A new prefix waits for the gap; one that gets no answer says so and is not kept.
+	start := time.Now()
+	f.serve(t, "GET", "/v1/guilds/1/members?query=silent", route, members)
+	if _, body = f.serve(t, "GET", "/v1/guilds/1/members?query=silent", route, members); body["timeout"] != true || len(sent) != 3 {
+		t.Errorf("timeout: %v %v", body, sent)
+	}
+	if time.Since(start) < weftSearchGap {
+		t.Errorf("two searches closer than the gap")
+	}
+}
diff --git a/weft_open.go b/weft_open.go
new file mode 100644
index 0000000..a49792c
--- /dev/null
+++ b/weft_open.go
@@ -0,0 +1,110 @@
+package main
+
+// POST /v1/channels/{channelID}/open: one of Karchi's existing Discord DMs or groups as a live room, what
+// `create-portal` does (commands.go) without a command in the bot's room (DISCORD-PLAN.md, point 1, step 2).
+//
+//	200 {"state": "joined", "room_id": …}      Karchi is in the room (a room the bridge had already: no request
+//	                                           to Discord; a new one: the channel's GET and the usual backfill)
+//	200 {"state": "invited", "room_id": …}     invited only (double puppeting did not join): Weft joins itself
+//	200 {"state": "not_joined", "room_id": …}  the room exists, Karchi is neither in it nor invited
+//	404 not one of Karchi's channels, 409 a group while another account is logged in, 503 not connected yet,
+//	502 Discord did not answer
+//
+// Only Karchi's own channels, known to the bridge already: a DM whose receiver is his Discord account, or a group
+// he is in (user_portal). A group room is made only while no other account is logged in (CreateMatrixRoom invites
+// every logged-in member). An account that signs in later, also while the room is being made, is invited into its
+// groups' rooms by the bridge's own sync on READY (handlePrivateChannel -> UpdateInfo), as into any group room, so
+// no lock here could keep it out. One opening at a time.
+
+import (
+	"net/http"
+	"regexp"
+	"sync"
+
+	"github.com/bwmarrin/discordgo"
+	"github.com/gorilla/mux"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+var (
+	weftOpenLock  sync.Mutex
+	weftChannelID = regexp.MustCompile(`^[0-9]{1,20}$`)
+)
+
+// weftOwnChannel: the bridge's row of `channel` when it is Karchi's (account: his Discord id), else an HTTP status.
+func weftOwnChannel(db *database.Database, user *User, account, channel string) (*database.Portal, int) {
+	row := db.Portal.GetByID(database.NewPortalKey(channel, account))
+	switch {
+	case row == nil:
+		return nil, http.StatusNotFound
+	case row.Type == discordgo.ChannelTypeDM && row.Key.Receiver == account:
+		return row, 0
+	case row.Type == discordgo.ChannelTypeGroupDM && row.Key.Receiver == "" && user.IsInPortal(channel):
+		if len(db.User.GetAllWithToken()) != 1 {
+			return nil, http.StatusConflict
+		}
+		return row, 0
+	}
+	return nil, http.StatusNotFound
+}
+
+func (p *ProvisioningAPI) weftOpen(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	channel := mux.Vars(r)["channelID"]
+	if !weftChannelID.MatchString(channel) {
+		jsonResponse(w, http.StatusBadRequest, Error{Error: "Not a channel ID", ErrCode: "M_INVALID_PARAM"})
+		return
+	}
+	account, _, _, _, ok := user.weftNow()
+	if !ok {
+		jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Not connected to Discord yet", ErrCode: "FI.MAU.DISCORD.NOT_READY"})
+		return
+	}
+	weftOpenLock.Lock()
+	defer weftOpenLock.Unlock()
+	row, status := weftOwnChannel(p.bridge.DB, user, account, channel)
+	if status == http.StatusConflict {
+		jsonResponse(w, status, Error{Error: "The bridge has another logged-in account", ErrCode: "SK.KARCHI.WEFT.OTHER_ACCOUNTS"})
+		return
+	} else if row == nil {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Not one of your Discord chats", ErrCode: "M_NOT_FOUND"})
+		return
+	}
+	portal := p.bridge.GetExistingPortalByID(row.Key)
+	store := p.bridge.AS.StateStore
+	if portal.MXID != "" && !store.IsInRoom(portal.MXID, user.MXID) {
+		portal.ensureUserInvited(user, true) // Matrix only, as CreateMatrixRoom does for a room it has
+	} else if portal.MXID == "" {
+		user.Lock()
+		session := user.Session
+		user.Unlock()
+		if session == nil {
+			jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Not connected to Discord", ErrCode: "FI.MAU.DISCORD.NOT_READY"})
+			return
+		}
+		meta, err := session.Channel(channel)
+		if err != nil || meta == nil || meta.ID != channel {
+			p.log.Warnfln("Weft: failed to get channel %s: %v", channel, err)
+			jsonResponse(w, http.StatusBadGateway, Error{Error: "Discord did not give the channel", ErrCode: "SK.KARCHI.WEFT.DISCORD"})
+			return
+		}
+		// Another account signed in during the GET: no room, it would be invited at once.
+		if _, status = weftOwnChannel(p.bridge.DB, user, account, channel); status != 0 {
+			jsonResponse(w, http.StatusConflict, Error{Error: "The bridge has another logged-in account", ErrCode: "SK.KARCHI.WEFT.OTHER_ACCOUNTS"})
+			return
+		}
+		if err = portal.CreateMatrixRoom(user, meta); err != nil {
+			p.log.Warnfln("Weft: failed to create room for %s: %v", channel, err)
+			jsonResponse(w, http.StatusInternalServerError, Error{Error: "The room was not created", ErrCode: "M_UNKNOWN"})
+			return
+		}
+	}
+	state := "not_joined"
+	if store.IsInRoom(portal.MXID, user.MXID) {
+		state = "joined"
+	} else if store.IsInvited(portal.MXID, user.MXID) {
+		state = "invited"
+	}
+	jsonResponse(w, http.StatusOK, map[string]any{"state": state, "room_id": portal.MXID})
+}
diff --git a/weft_open_test.go b/weft_open_test.go
new file mode 100644
index 0000000..3bdb0c8
