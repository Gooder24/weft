From eab207a6f79e8b7273f6533a97c8bd46635be76f Mon Sep 17 00:00:00 2001
From: Gooder24 <162874774+Gooder24@users.noreply.github.com>
Date: Thu, 26 Nov 2026 08:24:39 +0100
Subject: [PATCH] igconnector: open an existing thread by its FBID through
 create_dm/thread:<fbid>

Instagram's data export names each conversation by the thread's FBID. A group
whose last activity is older than the first inbox page never becomes a portal,
so it could not be written to again from Matrix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/igconnector/openthread.go | 105 ++++++++++++++++++++++++++++++++++
 pkg/igconnector/startchat.go  |   3 +
 2 files changed, 108 insertions(+)
 create mode 100644 pkg/igconnector/openthread.go

diff --git a/pkg/igconnector/openthread.go b/pkg/igconnector/openthread.go
new file mode 100644
index 0000000..fa5d8d4
--- /dev/null
+++ b/pkg/igconnector/openthread.go
@@ -0,0 +1,105 @@
+package igconnector
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-meta/pkg/instameow/slidetypes"
+)
+
+// threadIdentifierPrefix marks an existing thread by the number in Instagram's web address /direct/t/<id>/ and in
+// the folder names of Instagram's data export: a group's FBID, or a DM's chat ID (its portal is keyed by the other
+// person's FBID instead). POST /v3/create_dm/thread:<fbid>
+// opens such a thread as a portal; GET /v3/resolve_identifier/thread:<fbid> only says whether one exists.
+const threadIdentifierPrefix = "thread:"
+
+func (ic *IGClient) resolveThread(ctx context.Context, rawID string, createChat bool) (*bridgev2.ResolveIdentifierResponse, error) {
+	fbid, err := strconv.ParseInt(rawID, 10, 64)
+	if err != nil || fbid <= 0 {
+		return nil, bridgev2.WrapRespErr(fmt.Errorf("invalid thread ID %q", rawID), mautrix.MInvalidParam)
+	}
+	keys := []networkid.PortalKey{ic.makePortalKey(fbid, true), ic.makePortalKey(fbid, false)}
+	if dmFBID, err := ic.Main.DB.GetFBIDForIGChat(ctx, rawID, ic.UserLogin.ID); err != nil {
+		return nil, fmt.Errorf("failed to get chat ID mapping: %w", err)
+	} else if dmFBID != 0 && dmFBID != fbid {
+		keys = append(keys, ic.makePortalKey(dmFBID, false))
+	}
+	for _, key := range keys {
+		portal, err := ic.Main.Bridge.GetExistingPortalByKey(ctx, key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to get existing portal: %w", err)
+		} else if portal != nil && portal.MXID != "" {
+			// Provisioning deletes a room the user is not in and makes a new one (CleanupOrphanedDM). A room being
+			// created right now (another open of the same thread) gets the user in a moment: wait for that, and
+			// never let a lookup (GET) delete a room.
+			if !createChat && !ic.userInRoom(ctx, portal.MXID) {
+				return nil, nil
+			}
+			ic.waitUserInRoom(ctx, portal.MXID) // still not in after it: provisioning makes a new room
+			return &bridgev2.ResolveIdentifierResponse{Chat: &bridgev2.CreateChatResponse{PortalKey: portal.PortalKey, Portal: portal}}, nil
+		}
+	}
+	if !createChat {
+		return nil, nil
+	}
+	// One thread info request, the same one the bridge makes for a group it has just created.
+	resp, err := ic.Client.GetThread(ctx, slidetypes.MakeGetThreadInfoRequest(rawID))
+	if err != nil {
+		return nil, fmt.Errorf("failed to get thread %d: %w", fbid, err)
+	}
+	thread := resp.ThreadInfo.AsIGDirectThread
+	if thread == nil || (thread.ThreadKey != fbid && thread.ID != rawID && thread.ThreadFBID != rawID) {
+		return nil, bridgev2.WrapRespErr(fmt.Errorf("thread %d not found", fbid), mautrix.MNotFound)
+	}
+	if err = ic.saveThreadMappings(ctx, thread); err != nil {
+		return nil, fmt.Errorf("failed to save thread mappings: %w", err)
+	}
+	key := ic.makePortalKey(thread.ThreadKey, thread.IsGroup)
+	portal, err := ic.Main.Bridge.GetPortalByKey(ctx, key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get portal: %w", err)
+	}
+	// The room is made here and handed back only once the user is in it: provisioning's CleanupOrphanedDM would
+	// delete a room the user has not got into yet. The portal's event loop runs one creation at a time, so a
+	// second open of the same thread gets the same room.
+	if err = portal.CreateMatrixRoom(ctx, ic.UserLogin, ic.wrapChatInfo(thread)); err != nil {
+		return nil, fmt.Errorf("failed to create portal room: %w", err)
+	}
+	ic.waitUserInRoom(ctx, portal.MXID)
+	return &bridgev2.ResolveIdentifierResponse{Chat: &bridgev2.CreateChatResponse{PortalKey: key, Portal: portal}}, nil
+}
+
+func (ic *IGClient) userInRoom(ctx context.Context, roomID id.RoomID) bool {
+	members, err := ic.Main.Bridge.Matrix.GetMembers(ctx, roomID)
+	if err != nil {
+		return false
+	}
+	member, ok := members[ic.UserLogin.UserMXID]
+	return ok && member.Membership.IsInviteOrJoin()
+}
+
+// waitUserInRoom waits up to ten seconds for the user to get into a room that is being created.
+func (ic *IGClient) waitUserInRoom(ctx context.Context, roomID id.RoomID) {
+	for range 20 {
+		if ic.userInRoom(ctx, roomID) {
+			return
+		}
+		select {
+		case <-time.After(500 * time.Millisecond):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func cutThreadIdentifier(identifier string) (string, bool) {
+	return strings.CutPrefix(identifier, threadIdentifierPrefix)
+}
diff --git a/pkg/igconnector/startchat.go b/pkg/igconnector/startchat.go
index 6100e86..625acc4 100644
--- a/pkg/igconnector/startchat.go
+++ b/pkg/igconnector/startchat.go
@@ -51,6 +51,9 @@ func (ic *IGClient) ResolveIdentifier(ctx context.Context, identifier string, cr
 	if ic.LoginMeta.Cookies == nil {
 		return nil, bridgev2.ErrNotLoggedIn
 	}
+	if threadID, ok := cutThreadIdentifier(identifier); ok {
+		return ic.resolveThread(ctx, threadID, createChat)
+	}
 
 	id, err := metaid.ParseIDFromString(identifier)
 	if err != nil {
