diff --git a/pkg/connector/weftprofile.go b/pkg/connector/weftprofile.go
new file mode 100644
index 0000000..cf57eba
--- /dev/null
+++ b/pkg/connector/weftprofile.go
@@ -0,0 +1,134 @@
+package connector
+
+// Weft's person panel asks for one WhatsApp contact's "about" text:
+//
+//	GET /_matrix/provision/v3/weft/profile/{userID}   (userID is the ghost's id: 421…, or lid-…)
+//	→ {"about": "…", "fetched_at": 1794…, "ids": ["421…", "lid-…"]}
+//
+// about is "" when the person has none or hides it. ids are every user id the bridge knows for the person (phone
+// number and LID): a status may come from the other one than the chat's.
+//
+// It is the usync "status" query the phone makes when a contact's info opens: nobody is told. One query per
+// person at most every hour (answers are cached), and at least two seconds between queries, whatever the caller does.
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"time"
+
+	"go.mau.fi/util/exhttp"
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+
+	"go.mau.fi/mautrix-whatsapp/pkg/waid"
+)
+
+type weftAbout struct {
+	About     string `json:"about"`
+	FetchedAt int64  `json:"fetched_at"`
+}
+
+const (
+	weftAboutTTL = time.Hour
+	weftAboutGap = 2 * time.Second
+)
+
+type weftProfiles struct {
+	lock  sync.Mutex // one upstream query at a time
+	last  time.Time
+	cache map[types.JID]weftAbout
+	now   func() time.Time
+}
+
+// about answers from the cache, else asks WhatsApp through query (one person's about text).
+func (p *weftProfiles) about(ctx context.Context, jid types.JID, query func(context.Context, types.JID) (string, error)) (weftAbout, error) {
+	p.lock.Lock()
+	defer p.lock.Unlock()
+	if got, ok := p.cache[jid]; ok && p.now().Sub(time.UnixMilli(got.FetchedAt)) < weftAboutTTL {
+		return got, nil
+	}
+	if wait := weftAboutGap - p.now().Sub(p.last); wait > 0 {
+		select {
+		case <-time.After(wait):
+		case <-ctx.Done():
+			return weftAbout{}, ctx.Err()
+		}
+	}
+	p.last = p.now()
+	text, err := query(ctx, jid)
+	if err != nil {
+		return weftAbout{}, err
+	}
+	got := weftAbout{About: text, FetchedAt: p.now().UnixMilli()}
+	p.cache[jid] = got
+	return got, nil
+}
+
+// weftIDs are the person's ghost ids under both the phone number and the LID, as far as the bridge knows them.
+func (wa *WhatsAppClient) weftIDs(ctx context.Context, jid types.JID) []string {
+	ids := []string{string(waid.MakeUserID(jid))}
+	var other types.JID
+	if jid.Server == types.HiddenUserServer {
+		other, _ = wa.GetStore().LIDs.GetPNForLID(ctx, jid)
+	} else {
+		other, _ = wa.GetStore().LIDs.GetLIDForPN(ctx, jid)
+	}
+	if !other.IsEmpty() {
+		ids = append(ids, string(waid.MakeUserID(other)))
+	}
+	return ids
+}
+
+// weftQueryJID is the id a usync query is made with: the phone number when the bridge knows it for a LID.
+func (wa *WhatsAppClient) weftQueryJID(ctx context.Context, jid types.JID) types.JID {
+	if jid.Server != types.HiddenUserServer {
+		return jid
+	}
+	if pn, err := wa.GetStore().LIDs.GetPNForLID(ctx, jid); err == nil && !pn.IsEmpty() {
+		return pn
+	}
+	return jid
+}
+
+func (wa *WhatsAppConnector) registerWeftProfile() {
+	mc, ok := wa.Bridge.Matrix.(bridgev2.MatrixConnectorWithProvisioning)
+	if !ok || mc.GetProvisioning() == nil {
+		return
+	}
+	prov := mc.GetProvisioning()
+	profiles := &weftProfiles{cache: make(map[types.JID]weftAbout), now: time.Now}
+	prov.GetRouter().HandleFunc("GET /v3/weft/profile/{userID}", func(w http.ResponseWriter, r *http.Request) {
+		var client *WhatsAppClient
+		if login := prov.GetUser(r).GetDefaultLogin(); login != nil {
+			client, _ = login.Client.(*WhatsAppClient)
+		}
+		if client == nil || client.Client == nil || !client.IsLoggedIn() {
+			mautrix.MNotFound.WithMessage("WhatsApp is not connected").Write(w)
+			return
+		}
+		jid := waid.ParseUserID(networkid.UserID(r.PathValue("userID")))
+		if jid.User == "" || (jid.Server != types.DefaultUserServer && jid.Server != types.HiddenUserServer) {
+			mautrix.MInvalidParam.WithMessage("Not a WhatsApp person").Write(w)
+			return
+		}
+		got, err := profiles.about(r.Context(), jid, func(ctx context.Context, jid types.JID) (string, error) {
+			ask := client.weftQueryJID(ctx, jid)
+			infos, err := client.Client.GetUserInfo(ctx, []types.JID{ask})
+			if err != nil {
+				return "", err
+			}
+			return infos[ask].Status, nil
+		})
+		if err != nil {
+			mautrix.MUnknown.WithMessage("WhatsApp did not answer: " + err.Error()).Write(w)
+			return
+		}
+		exhttp.WriteJSONResponse(w, http.StatusOK, struct {
+			weftAbout
+			IDs []string `json:"ids"`
+		}{got, client.weftIDs(r.Context(), jid)})
+	})
+}
diff --git a/pkg/connector/weftprofile_test.go b/pkg/connector/weftprofile_test.go
new file mode 100644
index 0000000..9c01a93
--- /dev/null
+++ b/pkg/connector/weftprofile_test.go
@@ -0,0 +1,43 @@
+package connector
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func TestWeftAboutCachesForAnHour(t *testing.T) {
+	now := time.Unix(1_800_000_000, 0)
+	p := &weftProfiles{cache: make(map[types.JID]weftAbout), now: func() time.Time { return now }}
+	calls := 0
+	query := func(context.Context, types.JID) (string, error) { calls++; return "Na horách", nil }
+	jid := types.NewJID("421900000000", types.DefaultUserServer)
+	for i := 0; i < 3; i++ {
+		got, err := p.about(context.Background(), jid, query)
+		if err != nil || got.About != "Na horách" {
+			t.Fatalf("about = %+v, %v", got, err)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("asked WhatsApp %d times within the hour, want 1", calls)
+	}
+	now = now.Add(weftAboutTTL + time.Second)
+	if _, err := p.about(context.Background(), jid, query); err != nil || calls != 2 {
+		t.Fatalf("after an hour: calls %d, err %v", calls, err)
+	}
+}
+
+func TestWeftAboutWaitsBetweenQueries(t *testing.T) {
+	p := &weftProfiles{cache: make(map[types.JID]weftAbout), now: time.Now}
+	asked := false
+	query := func(context.Context, types.JID) (string, error) { asked = true; return "", nil }
+	p.last = time.Now()
+	// The caller has gone away while the bridge still has to wait: nothing is asked.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := p.about(ctx, types.NewJID("1", types.DefaultUserServer), query); err == nil || asked {
+		t.Fatal("a second person right after the first was asked at once")
+	}
+}
diff --git a/pkg/connector/weftstatus_test.go b/pkg/connector/weftstatus_test.go
new file mode 100644
index 0000000..f94f37a
--- /dev/null
+++ b/pkg/connector/weftstatus_test.go
@@ -0,0 +1,46 @@
+package connector
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/database"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+
+	"go.mau.fi/mautrix-whatsapp/pkg/waid"
+)
+
+// The client has no WhatsApp connection and the portal no bridge or database: anything that tried to tell
+// WhatsApp about a status would panic instead of returning.
+func statusPortal() *bridgev2.Portal {
+	return &bridgev2.Portal{Portal: &database.Portal{PortalKey: networkid.PortalKey{ID: waid.MakePortalID(types.StatusBroadcastJID)}}}
+}
+
+func TestStatusReadReceiptStaysUnseen(t *testing.T) {
+	wa := &WhatsAppClient{}
+	now := time.Now()
+	err := wa.HandleMatrixReadReceipt(context.Background(), &bridgev2.MatrixReadReceipt{Portal: statusPortal(), ReadUpTo: now, LastRead: now.Add(-time.Hour)})
+	if err != nil {
+		t.Fatalf("a read receipt in the status room: %v", err)
+	}
+}
+
+func TestStatusTypingGoesNowhere(t *testing.T) {
+	wa := &WhatsAppClient{}
+	if err := wa.HandleMatrixTyping(context.Background(), &bridgev2.MatrixTyping{Portal: statusPortal(), IsTyping: true}); err != nil {
+		t.Fatalf("typing in the status room: %v", err)
+	}
+}
+
+func TestStatusMediaIsNotAskedAgain(t *testing.T) {
+	wa := &WhatsAppClient{}
+	poster := types.NewJID("421900000000", types.DefaultUserServer)
+	err := wa.sendMediaRequestDirect(context.Background(), waid.MakeMessageID(types.StatusBroadcastJID, poster, "3A0000"), []byte("key"))
+	if !errors.Is(err, errStatusMediaRetry) {
+		t.Fatalf("media retry for a status: %v", err)
+	}
+}
