+package main
+
+// Discord polls as MSC3381 polls (Weft's patch, server/bridges/discord-polls.patch in Gooder24/weft).
+//
+// A poll becomes an org.matrix.msc3381.poll.start part (attachment id "poll") whose answer ids are Discord's
+// answer ids. Discord tells a user account only how many voted for each answer (and whether the user did), not who,
+// so the part also carries those counts in sk.karchi.discord.poll; each change of them (a MESSAGE_UPDATE of the poll)
+// replaces the part with the new counts. The poll result message (type 46) becomes a poll.end. Karchi's own
+// poll.response is sent to Discord as his vote.
+
+import (
+	"cmp"
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"github.com/rs/zerolog"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+var (
+	EventPollStart    = event.Type{Type: "org.matrix.msc3381.poll.start", Class: event.MessageEventType}
+	EventPollResponse = event.Type{Type: "org.matrix.msc3381.poll.response", Class: event.MessageEventType}
+	EventPollEnd      = event.Type{Type: "org.matrix.msc3381.poll.end", Class: event.MessageEventType}
+)
+
+const (
+	pollPartID       = "poll"
+	pollResultsField = "sk.karchi.discord.poll"
+	// MessageTypePollResult is the system message Discord posts when a poll ends.
+	MessageTypePollResult discordgo.MessageType = 46
+)
+
+func pollText(media discordgo.PollMedia) string {
+	text := media.Text
+	if e := media.Emoji; e != nil && e.Name != "" {
+		if e.ID == "" {
+			text = strings.TrimSpace(e.Name + " " + text)
+		} else if text == "" {
+			text = ":" + e.Name + ":"
+		}
+	}
+	return text
+}
+
+// pollState is what Discord tells about a poll's votes: counts per answer id, the answers Karchi picked, and
+// whether the poll is over.
+func pollState(poll *discordgo.Poll) map[string]any {
+	counts := map[string]any{}
+	mine := []string{}
+	closed := false
+	if poll.Results != nil {
+		closed = poll.Results.Finalized
+		for _, c := range poll.Results.AnswerCounts {
+			if c == nil {
+				continue
+			}
+			counts[strconv.Itoa(c.ID)] = c.Count
+			if c.MeVoted {
+				mine = append(mine, strconv.Itoa(c.ID))
+			}
+		}
+	}
+	state := map[string]any{"counts": counts, "mine": mine, "closed": closed, "multi": poll.AllowMultiselect}
+	if poll.Expiry != nil {
+		state["expiry"] = poll.Expiry.UnixMilli()
+	}
+	return state
+}
+
+// pollStartContent is the poll as an MSC3381 poll start with a plain-text fallback for other clients.
+func pollStartContent(poll *discordgo.Poll) (*event.MessageEventContent, map[string]any) {
+	question := pollText(poll.Question)
+	answers := make([]map[string]any, 0, len(poll.Answers))
+	lines := []string{question}
+	for _, a := range poll.Answers {
+		if a.Media == nil {
+			continue
+		}
+		text := pollText(*a.Media)
+		answers = append(answers, map[string]any{"id": strconv.Itoa(a.AnswerID), "org.matrix.msc1767.text": text})
+		lines = append(lines, fmt.Sprintf("%d. %s", len(answers), text))
+	}
+	maxSelections := 1
+	if poll.AllowMultiselect {
+		maxSelections = len(answers)
+	}
+	fallback := strings.Join(lines, "\n")
+	extra := map[string]any{
+		"org.matrix.msc1767.text": fallback,
+		"org.matrix.msc3381.poll.start": map[string]any{
+			"kind":           "org.matrix.msc3381.poll.disclosed",
+			"max_selections": maxSelections,
+			"question":       map[string]any{"org.matrix.msc1767.text": question},
+			"answers":        answers,
+		},
+		pollResultsField: pollState(poll),
+	}
+	return &event.MessageEventContent{MsgType: event.MsgText, Body: fallback}, extra
+}
+
+// pollEditContent is the poll start with new counts, as a replacement of the bridged one.
+func pollEditContent(poll *discordgo.Poll, target id.EventID) (*event.MessageEventContent, map[string]any) {
+	content, extra := pollStartContent(poll)
+	newContent := map[string]any{"msgtype": content.MsgType, "body": content.Body}
+	for k, v := range extra {
+		newContent[k] = v
+	}
+	edit := &event.MessageEventContent{MsgType: event.MsgText, Body: "* " + content.Body}
+	edit.RelatesTo = (&event.RelatesTo{}).SetReplace(target)
+	return edit, map[string]any{"m.new_content": newContent}
+}
+
+// pollEndText is the line Discord's poll result message stands for.
+func pollEndText(msg *discordgo.Message) string {
+	fields := map[string]string{}
+	for _, e := range msg.Embeds {
+		if e == nil || e.Type != "poll_result" {
+			continue
+		}
+		for _, f := range e.Fields {
+			if f != nil {
+				fields[f.Name] = f.Value
+			}
+		}
+	}
+	question := fields["poll_question_text"]
+	winner := fields["victor_answer_text"]
+	if emoji := fields["victor_answer_emoji_name"]; emoji != "" && fields["victor_answer_emoji_id"] == "" {
+		winner = strings.TrimSpace(emoji + " " + winner)
+	}
+	text := "The poll has ended"
+	if question != "" {
+		text += ": " + question
+	}
+	if winner != "" {
+		text += fmt.Sprintf("\nWinning answer: %s (%s of %s votes)", winner, fields["victor_answer_votes"], fields["total_votes"])
+	}
+	return text
+}
+
+// pollEndContent ends the bridged poll start target.
+func pollEndContent(msg *discordgo.Message, target id.EventID) (*event.MessageEventContent, map[string]any) {
+	text := pollEndText(msg)
+	content := &event.MessageEventContent{MsgType: event.MsgNotice, Body: text}
+	content.RelatesTo = &event.RelatesTo{Type: event.RelReference, EventID: target}
+	return content, map[string]any{
+		"org.matrix.msc1767.text":     text,
+		"org.matrix.msc3381.poll.end": map[string]any{},
+	}
+}
+
+// pollResponseAnswers are the Discord answer ids of an MSC3381 poll response; ok is false when it is no response.
+func pollResponseAnswers(raw map[string]any) (answers []int, target id.EventID, ok bool) {
+	rel, _ := raw["m.relates_to"].(map[string]any)
+	if rel == nil || rel["rel_type"] != string(event.RelReference) {
+		return nil, "", false
+	}
+	evtID, _ := rel["event_id"].(string)
+	resp, _ := raw["org.matrix.msc3381.poll.response"].(map[string]any)
+	if resp == nil || evtID == "" {
+		return nil, "", false
+	}
+	list, ok := resp["answers"].([]any)
+	if !ok {
+		return nil, "", false
+	}
+	// One answer that is no Discord answer id makes it no vote: sending the rest would take a vote back.
+	answers = []int{}
+	seen := map[int]bool{}
+	for _, a := range list {
+		s, _ := a.(string)
+		n, err := strconv.Atoi(s)
+		if err != nil || n <= 0 {
+			return nil, "", false
+		}
+		if seen[n] {
+			continue
+		}
+		seen[n] = true
+		answers = append(answers, n)
+	}
+	return answers, id.EventID(evtID), true
+}
+
+// sendPollVote puts Karchi's answers as his vote (an empty list takes it back), like Discord's own client does.
+func sendPollVote(session *discordgo.Session, channelID, messageID string, answers []int) error {
+	ids := make([]string, len(answers))
+	for i, a := range answers {
+		ids[i] = strconv.Itoa(a)
+	}
+	endpoint := discordgo.EndpointPoll(channelID, messageID) + "/answers/@me"
+	_, err := session.RequestWithBucketID("PUT", endpoint, map[string]any{"answer_ids": ids}, discordgo.EndpointPoll(channelID, ""))
+	return err
+}
+
+// pollEditGap is the least time between two bridged count changes of one poll; changes in between are sent
+// together. An ended poll's counts go at once.
+var pollEditGap = 15 * time.Second
+
+// pollThrottle sends a poll's newest counts, at most once per pollEditGap and only when they changed; a failed
+// send is tried again after the gap, up to three times. Sending happens outside the lock, so the portal's
+// message loop never waits for the homeserver.
+type pollThrottle struct {
+	mu        sync.Mutex
+	poll      *discordgo.Poll
+	base      *discordgo.Poll // the last update with the question and answers
+	last      string
+	lastSent  time.Time
+	scheduled bool
+	sending   bool // one send at a time, so an older count never lands after a newer one
+	failures  int
+	send      func(*discordgo.Poll) error
+	done      func() // called once an ended poll's counts are bridged
+}
+
+// update takes Discord's newest counts. An update that carries only the results keeps the question and answers
+// of the last full one (base, else the poll as it was created).
+func (t *pollThrottle) update(poll, created *discordgo.Poll) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if len(poll.Answers) > 0 {
+		t.base = poll
+	} else if base := cmp.Or(t.base, created); base != nil && len(base.Answers) > 0 {
+		merged := *base
+		merged.Results = poll.Results
+		poll = &merged
+	}
+	t.poll = poll
+	t.failures = 0
+	if !t.sending {
+		t.schedule()
+	}
+}
+
+// schedule must be called with mu held.
+func (t *pollThrottle) schedule() {
+	if t.scheduled {
+		return
+	}
+	wait := time.Until(t.lastSent.Add(pollEditGap))
+	if t.failures == 0 && t.poll.Results != nil && t.poll.Results.Finalized {
+		wait = 0
+	}
+	t.scheduled = true
+	time.AfterFunc(max(wait, 0), t.flush)
+}
+
+func (t *pollThrottle) flush() {
+	t.mu.Lock()
+	t.scheduled = false
+	poll := t.poll
+	state, _ := json.Marshal(pollState(poll))
+	if string(state) == t.last {
+		t.mu.Unlock()
+		return
+	}
+	t.lastSent = time.Now()
+	t.sending = true
+	t.mu.Unlock()
+	err := t.send(poll)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.sending = false
+	if err != nil {
+		if t.failures++; t.failures < 3 || t.poll != poll {
+			t.schedule()
+		}
+		return
+	}
+	t.last = string(state)
+	if t.poll != poll {
+		t.schedule() // newer counts came while this one was on its way
+	} else if poll.Results != nil && poll.Results.Finalized && t.done != nil {
+		t.done()
+	}
+}
+
+var pollThrottles sync.Map // id.EventID -> *pollThrottle
+
+// updateDiscordPoll replaces the bridged poll start with Discord's new counts.
+func (portal *Portal) updateDiscordPoll(ctx context.Context, part *database.Message, poll *discordgo.Poll) {
+	log := zerolog.Ctx(ctx).With().Str("poll_mxid", part.MXID.String()).Logger()
+	v, _ := pollThrottles.LoadOrStore(part.MXID, &pollThrottle{done: func() { pollThrottles.Delete(part.MXID) }, send: func(poll *discordgo.Poll) error {
+		intent := portal.bridge.GetPuppetByID(part.SenderID).IntentFor(portal)
+		content, extra := pollEditContent(poll, part.MXID)
+		_, err := portal.sendMatrixMessage(intent, EventPollStart, content, extra, 0)
+		if err != nil {
+			log.Err(err).Msg("Failed to bridge poll counts")
+		}
+		return err
+	}})
+	var created *discordgo.Poll
+	if msg, ok := portal.recentMessages.Get(part.DiscordID); ok && msg != nil {
+		created = msg.Poll
+	}
+	v.(*pollThrottle).update(poll, created)
+}
+
+// handleMatrixPollResponse sends Karchi's vote to Discord.
+func (portal *Portal) handleMatrixPollResponse(sender *User, evt *event.Event) {
+	log := portal.log.With().Str("event_id", evt.ID.String()).Str("action", "matrix poll response").Logger()
+	answers, target, ok := pollResponseAnswers(evt.Content.Raw)
+	if !ok {
+		go portal.sendMessageMetrics(evt, fmt.Errorf("%w: not a poll response", errUnknownMsgType), "Ignoring")
+		return
+	}
+	poll := portal.bridge.DB.Message.GetByMXID(portal.Key, target)
+	if poll == nil || poll.AttachmentID != pollPartID {
+		go portal.sendMessageMetrics(evt, fmt.Errorf("%w: unknown poll", errTargetNotFound), "Ignoring")
+		return
+	}
+	if sender.Session == nil || sender.DiscordID == "" {
+		go portal.sendMessageMetrics(evt, errUserNotLoggedIn, "Ignoring")
+		return
+	}
+	err := sendPollVote(sender.Session, poll.DiscordProtoChannelID(), poll.DiscordID, answers)
+	if err != nil {
+		log.Err(err).Msg("Failed to send poll vote")
+	}
+	go portal.sendMessageMetrics(evt, err, "Error sending")
+}
