@@ -0,0 +1,262 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/event"
+)
+
+// A poll as Discord's gateway sends it (shape of a collected real one, made-up text).
+const samplePoll = `{"question":{"text":"Kam na chatu?"},"answers":[{"answer_id":1,"poll_media":{"text":"Orava"}},
+{"answer_id":2,"poll_media":{"text":"Telgárt","emoji":{"name":"⛷️"}}},{"answer_id":3,"poll_media":{"text":"Zuberec"}}],
+"allow_multiselect":true,"expiry":"2026-10-15T21:00:53.912233+00:00","layout_type":1,
+"results":{"answer_counts":[{"id":3,"count":8,"me_voted":true},{"id":1,"count":6,"me_voted":false}],"is_finalized":false}}`
+
+func parsePoll(t *testing.T) *discordgo.Poll {
+	var p discordgo.Poll
+	if err := json.Unmarshal([]byte(samplePoll), &p); err != nil {
+		t.Fatal(err)
+	}
+	return &p
+}
+
+// marshal is the event content exactly as the bridge sends it to the homeserver.
+func marshal(t *testing.T) func(*event.MessageEventContent, map[string]any) map[string]any {
+	return func(content *event.MessageEventContent, extra map[string]any) map[string]any {
+		data, err := json.Marshal(&event.Content{Parsed: content, Raw: extra})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var out map[string]any
+		if err := json.Unmarshal(data, &out); err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+}
+
+func TestPollStart(t *testing.T) {
+	out := marshal(t)(pollStartContent(parsePoll(t)))
+	start := out["org.matrix.msc3381.poll.start"].(map[string]any)
+	if q := start["question"].(map[string]any)["org.matrix.msc1767.text"]; q != "Kam na chatu?" {
+		t.Errorf("question %v", q)
+	}
+	answers := start["answers"].([]any)
+	if len(answers) != 3 || answers[1].(map[string]any)["id"] != "2" || answers[1].(map[string]any)["org.matrix.msc1767.text"] != "⛷️ Telgárt" {
+		t.Errorf("answers %v", answers)
+	}
+	if start["max_selections"].(float64) != 3 {
+		t.Errorf("multi-select max %v", start["max_selections"])
+	}
+	state := out[pollResultsField].(map[string]any)
+	counts := state["counts"].(map[string]any)
+	if counts["3"].(float64) != 8 || counts["1"].(float64) != 6 || counts["2"] != nil {
+		t.Errorf("counts %v", counts)
+	}
+	if mine := state["mine"].([]any); len(mine) != 1 || mine[0] != "3" {
+		t.Errorf("mine %v", mine)
+	}
+	if state["closed"] != false || state["expiry"].(float64) != float64(time.Date(2026, 10, 15, 21, 0, 53, 912233000, time.UTC).UnixMilli()) {
+		t.Errorf("state %v", state)
+	}
+	if !strings.HasPrefix(out["body"].(string), "Kam na chatu?\n1. Orava\n2. ⛷️ Telgárt") {
+		t.Errorf("fallback %q", out["body"])
+	}
+}
+
+func TestPollEdit(t *testing.T) {
+	poll := parsePoll(t)
+	poll.Results.Finalized = true
+	out := marshal(t)(pollEditContent(poll, "$poll"))
+	rel := out["m.relates_to"].(map[string]any)
+	if rel["rel_type"] != "m.replace" || rel["event_id"] != "$poll" {
+		t.Errorf("relation %v", rel)
+	}
+	if out["org.matrix.msc3381.poll.start"] != nil {
+		t.Error("the edit itself must not be a second poll")
+	}
+	nc := out["m.new_content"].(map[string]any)
+	if nc["org.matrix.msc3381.poll.start"] == nil || nc[pollResultsField].(map[string]any)["closed"] != true {
+		t.Errorf("new content %v", nc)
+	}
+}
+
+func TestPollEnd(t *testing.T) {
+	var msg discordgo.Message
+	_ = json.Unmarshal([]byte(`{"type":46,"embeds":[{"type":"poll_result","fields":[
+		{"name":"poll_question_text","value":"Kam na chatu?"},{"name":"victor_answer_votes","value":"8"},
+		{"name":"total_votes","value":"15"},{"name":"victor_answer_id","value":"3"},{"name":"victor_answer_text","value":"Zuberec"}]}],
+		"message_reference":{"message_id":"42"}}`), &msg)
+	out := marshal(t)(pollEndContent(&msg, "$poll"))
+	if out["org.matrix.msc3381.poll.end"] == nil {
+		t.Error("no poll end")
+	}
+	rel := out["m.relates_to"].(map[string]any)
+	if rel["rel_type"] != "m.reference" || rel["event_id"] != "$poll" {
+		t.Errorf("relation %v", rel)
+	}
+	if out["body"] != "The poll has ended: Kam na chatu?\nWinning answer: Zuberec (8 of 15 votes)" {
+		t.Errorf("text %q", out["body"])
+	}
+}
+
+func TestPollResponseAnswers(t *testing.T) {
+	var raw map[string]any
+	_ = json.Unmarshal([]byte(`{"m.relates_to":{"rel_type":"m.reference","event_id":"$poll"},
+		"org.matrix.msc3381.poll.response":{"answers":["3","1","3"]}}`), &raw)
+	answers, target, ok := pollResponseAnswers(raw)
+	if !ok || target != "$poll" || len(answers) != 2 || answers[0] != 3 || answers[1] != 1 {
+		t.Errorf("got %v %v %v", answers, target, ok)
+	}
+	_ = json.Unmarshal([]byte(`{"m.relates_to":{"rel_type":"m.reference","event_id":"$poll"},
+		"org.matrix.msc3381.poll.response":{"answers":["x"]}}`), &raw)
+	if answers, _, ok := pollResponseAnswers(raw); ok {
+		t.Errorf("an answer that is no Discord id must not take the vote back: %v", answers)
+	}
+	_ = json.Unmarshal([]byte(`{"m.relates_to":{"rel_type":"m.reference","event_id":"$poll"},
+		"org.matrix.msc3381.poll.response":{"answers":[]}}`), &raw)
+	if answers, _, ok := pollResponseAnswers(raw); !ok || len(answers) != 0 {
+		t.Errorf("taking a vote back: %v %v", answers, ok)
+	}
+	if _, _, ok := pollResponseAnswers(map[string]any{"body": "hi"}); ok {
+		t.Error("a message is no vote")
+	}
+}
+
+// redirect sends every request of the session to a fake server instead of Discord.
+type redirect struct{ to *url.URL }
+
+func (r redirect) RoundTrip(req *http.Request) (*http.Response, error) {
+	req = req.Clone(req.Context())
+	req.URL.Scheme, req.URL.Host = r.to.Scheme, r.to.Host
+	return http.DefaultTransport.RoundTrip(req)
+}
+
+func TestSendPollVote(t *testing.T) {
+	var method, path, body string
+	fake := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, _ := io.ReadAll(r.Body)
+		method, path, body = r.Method, r.URL.Path, string(data)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer fake.Close()
+	to, _ := url.Parse(fake.URL)
+	session, _ := discordgo.New("fake-token")
+	session.Client = &http.Client{Transport: redirect{to}}
+	if err := sendPollVote(session, "100", "200", []int{3, 1}); err != nil {
+		t.Fatal(err)
+	}
+	if method != "PUT" || !strings.HasSuffix(path, "/channels/100/polls/200/answers/@me") || body != `{"answer_ids":["3","1"]}` {
+		t.Errorf("%s %s %s", method, path, body)
+	}
+	if err := sendPollVote(session, "100", "200", []int{}); err != nil || body != `{"answer_ids":[]}` {
+		t.Errorf("taking back: %v %s", err, body)
+	}
+}
+
+func TestPollThrottle(t *testing.T) {
+	pollEditGap = 200 * time.Millisecond
+	sent := make(chan string, 10)
+	th := &pollThrottle{send: func(p *discordgo.Poll) error {
+		sent <- strconv.Itoa(p.Results.AnswerCounts[0].Count)
+		return nil
+	}}
+	at := func(n int, final bool) *discordgo.Poll {
+		return &discordgo.Poll{Results: &discordgo.PollResults{Finalized: final, AnswerCounts: []*discordgo.PollAnswerCount{{ID: 1, Count: n}}}}
+	}
+	th.update(at(1, false), nil) // the first change goes at once
+	if got := <-sent; got != "1" {
+		t.Fatalf("first %s", got)
+	}
+	th.update(at(2, false), nil) // the next ones wait for the gap and go together
+	th.update(at(3, false), nil)
+	select {
+	case got := <-sent:
+		t.Fatalf("sent %s inside the gap", got)
+	case <-time.After(100 * time.Millisecond):
+	}
+	if got := <-sent; got != "3" {
+		t.Fatalf("batched %s", got)
+	}
+	th.update(at(3, false), nil) // no change, no edit
+	select {
+	case got := <-sent:
+		t.Fatalf("unchanged counts sent again: %s", got)
+	case <-time.After(300 * time.Millisecond):
+	}
+	th.update(at(4, true), nil) // the end goes at once
+	select {
+	case got := <-sent:
+		if got != "4" {
+			t.Fatalf("final %s", got)
+		}
+	case <-time.After(50 * time.Millisecond):
+		t.Fatal("the final counts waited")
+	}
+}
+
+func TestPollThrottleSendsOutsideLockAndRetries(t *testing.T) {
+	pollEditGap = 100 * time.Millisecond
+	release := make(chan struct{})
+	calls := make(chan int, 10)
+	n := 0
+	done := make(chan struct{})
+	th := &pollThrottle{done: func() { close(done) }, send: func(p *discordgo.Poll) error {
+		n++
+		calls <- n
+		if n == 1 {
+			<-release // the homeserver hangs
+			return fmt.Errorf("homeserver down")
+		}
+		return nil
+	}}
+	final := &discordgo.Poll{Results: &discordgo.PollResults{Finalized: true, AnswerCounts: []*discordgo.PollAnswerCount{{ID: 1, Count: 2}}}}
+	th.update(final, nil)
+	<-calls
+	returned := make(chan struct{})
+	go func() { th.update(final, nil); close(returned) }()
+	select {
+	case <-returned:
+	case <-time.After(100 * time.Millisecond):
+		t.Fatal("update waited for a hanging send")
+	}
+	close(release) // the first send fails, the retry after the gap succeeds
+	select {
+	case got := <-calls:
+		if got != 2 {
+			t.Fatalf("call %d", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("a failed send was not tried again")
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("an ended poll's throttle was not let go")
+	}
+}
+
+func TestPollResultsOnlyUpdateKeepsQuestion(t *testing.T) {
+	sent := make(chan *discordgo.Poll, 2)
+	th := &pollThrottle{send: func(p *discordgo.Poll) error { sent <- p; return nil }}
+	created := parsePoll(t)
+	only := &discordgo.Poll{Results: &discordgo.PollResults{AnswerCounts: []*discordgo.PollAnswerCount{{ID: 2, Count: 5}}}}
+	th.update(only, created)
+	got := <-sent
+	if got.Question.Text != "Kam na chatu?" || len(got.Answers) != 3 || got.Results.AnswerCounts[0].Count != 5 || !got.AllowMultiselect {
+		t.Errorf("merged %+v", got)
+	}
+	if created.Results.AnswerCounts[0].Count != 8 {
+		t.Error("the created poll was changed")
+	}
+}
