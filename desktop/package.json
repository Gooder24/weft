{
  "name": "spravy",
  "productName": "Správy",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.weft.desktop",
    "productName": "Weft",
    "extraMetadata": { "name": "weft" },
    "files": ["*.js", "server.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Weft",
      "artifactName": "Weft-Setup.exe"
    }
  }
}
